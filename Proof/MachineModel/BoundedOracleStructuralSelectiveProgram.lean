/-! ## Exact structural-response assembler -/

private def structuralSummaryInput
    (inputArity index next selectedCode compilerOutput : ℕ) : ℕ :=
  Nat.pair (inputArity - index) <|
    Nat.pair inputArity <|
      Nat.pair index <|
        Nat.pair next <|
          Nat.pair selectedCode compilerOutput

private def structuralSummaryAdapterOutput
    (compilerResult inputArity index : ℕ) : ℕ :=
  let stateAndWire := Nat.unpair compilerResult
  let remainingAndRest := Nat.unpair stateAndWire.1
  let nextAndSelected := Nat.unpair remainingAndRest.2
  structuralSummaryInput inputArity index nextAndSelected.1
    nextAndSelected.2 stateAndWire.2

private def structuralSummaryAdapterInput
    (compilerResult inputArity index : ℕ) : ℕ :=
  Nat.pair compilerResult (Nat.pair inputArity index)

private def structuralSummaryAdapterWorkBound
    (compilerResult inputArity index : ℕ) : ℕ :=
  max
    (structuralSummaryAdapterInput compilerResult inputArity index)
    (structuralSummaryAdapterOutput compilerResult inputArity index)

private def structuralSummaryAdapterBits
    (compilerResult inputArity index : ℕ) : ℕ :=
  natBitLength <|
    structuralSummaryAdapterWorkBound compilerResult inputArity index

/-- Strip the compiler's target countdown and lower its exact state/wire pair
to the already-proved response assembler ABI. -/
private def structuralSummaryAdapterProgram : NPOracleProgram :=
  [ .unpairLeft 0 2 1
  , .unpairRight 0 3 2
  , .unpairLeft 3 4 3
  , .unpairRight 3 5 4
  , .unpairLeft 2 6 5
  , .unpairRight 2 7 6
  , .unpairLeft 6 8 7
  , .unpairRight 6 9 8
  , .unpairLeft 9 10 9
  , .unpairRight 9 11 10
  , .pair 11 7 12 11
  , .pair 10 12 12 12
  , .pair 5 12 12 13
  , .pair 4 12 12 14
  , .subtract 4 5 13 15
  , .pair 13 12 0 16
  , .halt 0
  ]

@[simp] private theorem structuralSummaryAdapterProgram_oracleFree :
    OracleFree structuralSummaryAdapterProgram := by
  rfl

private theorem run_structuralSummaryAdapterProgram
    (inputLength compilerResult inputArity index : ℕ) :
    runNPOracleProgram structuralSummaryAdapterProgram
        (structuralSummaryAdapterBits compilerResult inputArity index)
        17
        (initialNPOracleState inputLength <|
          structuralSummaryAdapterInput
            compilerResult inputArity index) =
      some
        (structuralSummaryAdapterOutput
          compilerResult inputArity index) := by
  let stateAndWire := Nat.unpair compilerResult
  let remainingAndRest := Nat.unpair stateAndWire.1
  let nextAndSelected := Nat.unpair remainingAndRest.2
  let selectedTail := Nat.pair nextAndSelected.2 stateAndWire.2
  let nextTail := Nat.pair nextAndSelected.1 selectedTail
  let indexTail := Nat.pair index nextTail
  let arityTail := Nat.pair inputArity indexTail
  let gap := inputArity - index
  let input :=
    structuralSummaryAdapterInput compilerResult inputArity index
  let output :=
    structuralSummaryAdapterOutput compilerResult inputArity index
  let workBound :=
    structuralSummaryAdapterWorkBound compilerResult inputArity index
  let maximumBits :=
    structuralSummaryAdapterBits compilerResult inputArity index
  have hbitsOf : ∀ {value : ℕ}, value ≤ workBound →
      natBitLength value ≤ maximumBits := by
    intro value hvalue
    exact natBitLength_mono hvalue
  have hinput : input ≤ workBound := Nat.le_max_left _ _
  have houtput : output ≤ workBound := Nat.le_max_right _ _
  have hcompilerResult : compilerResult ≤ workBound := by
    exact
      (Nat.left_le_pair compilerResult
        (Nat.pair inputArity index)).trans hinput
  have hmetadata :
      Nat.pair inputArity index ≤ workBound := by
    exact
      (Nat.right_le_pair compilerResult
        (Nat.pair inputArity index)).trans hinput
  have hinputArity : inputArity ≤ workBound :=
    (Nat.left_le_pair inputArity index).trans hmetadata
  have hindex : index ≤ workBound :=
    (Nat.right_le_pair inputArity index).trans hmetadata
  have hstate : stateAndWire.1 ≤ workBound :=
    (Nat.unpair_left_le compilerResult).trans hcompilerResult
  have hwire : stateAndWire.2 ≤ workBound :=
    (Nat.unpair_right_le compilerResult).trans hcompilerResult
  have hremaining : remainingAndRest.1 ≤ workBound :=
    (Nat.unpair_left_le stateAndWire.1).trans hstate
  have hnextAndSelected : remainingAndRest.2 ≤ workBound :=
    (Nat.unpair_right_le stateAndWire.1).trans hstate
  have hnext : nextAndSelected.1 ≤ workBound :=
    (Nat.unpair_left_le remainingAndRest.2).trans hnextAndSelected
  have hselected : nextAndSelected.2 ≤ workBound :=
    (Nat.unpair_right_le remainingAndRest.2).trans hnextAndSelected
  have houtputForm : output = Nat.pair gap arityTail := by
    rfl
  have hgap : gap ≤ workBound := by
    exact (Nat.left_le_pair gap arityTail).trans (houtputForm ▸ houtput)
  have harityTail : arityTail ≤ workBound := by
    exact (Nat.right_le_pair gap arityTail).trans (houtputForm ▸ houtput)
  have hindexTail : indexTail ≤ workBound :=
    (Nat.right_le_pair inputArity indexTail).trans harityTail
  have hnextTail : nextTail ≤ workBound :=
    (Nat.right_le_pair index nextTail).trans hindexTail
  have hselectedTail : selectedTail ≤ workBound :=
    (Nat.right_le_pair nextAndSelected.1 selectedTail).trans hnextTail
  rw [show (17 : ℕ) = 16 + 1 by omega]
  rw [run_unpairLeft_instruction (value := compilerResult)
    (by rfl) rfl
    (by
      simp [initialNPOracleState,
        structuralSummaryAdapterInput])
    (hbitsOf hcompilerResult)]
  rw [show (16 : ℕ) = 15 + 1 by omega]
  rw [run_unpairRight_instruction
    (value := Nat.pair inputArity index)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump,
        structuralSummaryAdapterInput])
    (hbitsOf hmetadata)]
  rw [show (15 : ℕ) = 14 + 1 by omega]
  rw [run_unpairLeft_instruction (value := inputArity)
    (by rfl) rfl
    (by simp [NPOracleState.write, NPOracleState.jump])
    (hbitsOf hinputArity)]
  rw [show (14 : ℕ) = 13 + 1 by omega]
  rw [run_unpairRight_instruction (value := index)
    (by rfl) rfl
    (by simp [NPOracleState.write, NPOracleState.jump])
    (hbitsOf hindex)]
  rw [show (13 : ℕ) = 12 + 1 by omega]
  rw [run_unpairLeft_instruction (value := stateAndWire.1)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        stateAndWire])
    (hbitsOf hstate)]
  rw [show (12 : ℕ) = 11 + 1 by omega]
  rw [run_unpairRight_instruction (value := stateAndWire.2)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        stateAndWire])
    (hbitsOf hwire)]
  rw [show (11 : ℕ) = 10 + 1 by omega]
  rw [run_unpairLeft_instruction (value := remainingAndRest.1)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        stateAndWire, remainingAndRest])
    (hbitsOf hremaining)]
  rw [show (10 : ℕ) = 9 + 1 by omega]
  rw [run_unpairRight_instruction (value := remainingAndRest.2)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        stateAndWire, remainingAndRest])
    (hbitsOf hnextAndSelected)]
  rw [show (9 : ℕ) = 8 + 1 by omega]
  rw [run_unpairLeft_instruction (value := nextAndSelected.1)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        nextAndSelected])
    (hbitsOf hnext)]
  rw [show (8 : ℕ) = 7 + 1 by omega]
  rw [run_unpairRight_instruction (value := nextAndSelected.2)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        nextAndSelected])
    (hbitsOf hselected)]
  rw [show (7 : ℕ) = 6 + 1 by omega]
  rw [run_pair_instruction (value := selectedTail)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        selectedTail])
    (hbitsOf hselectedTail)]
  rw [show (6 : ℕ) = 5 + 1 by omega]
  rw [run_pair_instruction (value := nextTail)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        nextTail])
    (hbitsOf hnextTail)]
  rw [show (5 : ℕ) = 4 + 1 by omega]
  rw [run_pair_instruction (value := indexTail)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        indexTail])
    (hbitsOf hindexTail)]
  rw [show (4 : ℕ) = 3 + 1 by omega]
  rw [run_pair_instruction (value := arityTail)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        arityTail])
    (hbitsOf harityTail)]
  rw [show (3 : ℕ) = 2 + 1 by omega]
  rw [run_subtract_instruction (value := gap)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        gap])
    (hbitsOf hgap)]
  rw [show (2 : ℕ) = 1 + 1 by omega]
  rw [run_pair_instruction (value := output)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        output, structuralSummaryAdapterOutput,
        structuralSummaryInput, stateAndWire,
        remainingAndRest, nextAndSelected, selectedTail,
        nextTail, indexTail, arityTail, gap])
    (hbitsOf houtput)]
  exact run_halt_instruction (fuel := 0)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        output])
    (hbitsOf houtput)

private def structuralRawNodeAtom
    (inputArity wire rawNodeCode : ℕ) : ℕ :=
  Nat.pair inputArity <|
    Nat.pair 1 <|
      Nat.pair (inputArity + wire) rawNodeCode

private def structuralSummaryAtom
    (inputArity index selectedCode compilerOutput : ℕ) : ℕ :=
  if inputArity - index = 0 then
    if selectedCode = 0 then
      structuralRawNodeAtom inputArity compilerOutput (Nat.pair 0 1)
    else
      structuralRawNodeAtom inputArity (index - inputArity)
        (Nat.unpair selectedCode).2
  else
    Nat.pair inputArity (Nat.pair 0 index)

private def structuralSummaryOutput
    (inputArity index next selectedCode compilerOutput : ℕ) : ℕ :=
  Nat.pair (inputArity + next + 1) <|
    structuralSummaryAtom
      inputArity index selectedCode compilerOutput

/-- Assemble `(formulaLength, atom)` from the completed selective state.  The
three branches are the canonical input tautology, retained node, and final
output-unit fallback; no formula or node list is reconstructed. -/
private def structuralSummaryProgram : NPOracleProgram :=
  [ .unpairLeft 0 2 1
  , .unpairRight 0 3 2
  , .unpairLeft 3 4 3
  , .unpairRight 3 5 4
  , .unpairLeft 5 6 5
  , .unpairRight 5 7 6
  , .unpairLeft 7 8 7
  , .unpairRight 7 9 8
  , .unpairLeft 9 10 9
  , .unpairRight 9 11 10
  , .add 4 8 12 11
  , .increment 12 12
  , .branchZero 2 20 13
  , .set 13 0 14
  , .pair 13 6 14 15
  , .branchZero 13 36 36
  , .branchZero 13 36 36
  , .branchZero 13 36 36
  , .branchZero 13 36 36
  , .branchZero 13 36 36
  , .branchZero 10 29 21
  , .unpairRight 10 16 22
  , .subtract 6 4 17 23
  , .add 4 17 18 24
  , .add 18 13 18 25
  , .pair 18 16 19 26
  , .set 20 1 27
  , .pair 20 19 14 28
  , .branchZero 13 36 36
  , .set 13 0 30
  , .set 20 1 31
  , .pair 13 20 16 32
  , .add 4 11 18 33
  , .add 18 13 18 34
  , .pair 18 16 19 35
  , .pair 20 19 14 36
  , .pair 4 14 15 37
  , .pair 12 15 0 38
  , .halt 0
  ]

private def structuralSummaryFuel
    (inputArity index selectedCode : ℕ) : ℕ :=
  if inputArity - index = 0 then
    if selectedCode = 0 then 24 else 25
  else
    19

private def structuralSummaryWorkingValues
    (inputArity index next selectedCode compilerOutput : ℕ) : List ℕ :=
  let input :=
    structuralSummaryInput
      inputArity index next selectedCode compilerOutput
  let length := inputArity + next + 1
  let target := index - inputArity
  let selectedRaw := (Nat.unpair selectedCode).2
  let trueRaw := Nat.pair 0 1
  let selectedTail := Nat.pair selectedCode compilerOutput
  let nextTail := Nat.pair next selectedTail
  let indexTail := Nat.pair index nextTail
  let arityTail := Nat.pair inputArity indexTail
  let lengthBase := inputArity + next
  let selectedCurrent := inputArity + target
  let fallbackCurrent := inputArity + compilerOutput
  let selectedCurrentBase := inputArity + target
  let fallbackCurrentBase := inputArity + compilerOutput
  let selectedRequest := Nat.pair selectedCurrent selectedRaw
  let fallbackRequest := Nat.pair fallbackCurrent trueRaw
  let tautologyTag := Nat.pair 0 index
  let selectedTag := Nat.pair 1 selectedRequest
  let fallbackTag := Nat.pair 1 fallbackRequest
  let tautologyAtom := Nat.pair inputArity tautologyTag
  let selectedAtom := Nat.pair inputArity selectedTag
  let fallbackAtom := Nat.pair inputArity fallbackTag
  [ input, structuralSummaryOutput inputArity index next selectedCode
      compilerOutput
  , inputArity - index, inputArity, index, next, selectedCode
  , compilerOutput, selectedTail, nextTail, indexTail, arityTail
  , lengthBase, length, target, selectedRaw, trueRaw
  , selectedCurrentBase, fallbackCurrentBase
  , selectedCurrent, fallbackCurrent, selectedRequest, fallbackRequest
  , tautologyTag, selectedTag, fallbackTag
  , tautologyAtom, selectedAtom, fallbackAtom, 0, 1
  ]

private def structuralSummaryWorkBound
    (inputArity index next selectedCode compilerOutput : ℕ) : ℕ :=
  (structuralSummaryWorkingValues
    inputArity index next selectedCode compilerOutput).foldr max 0

private def structuralSummaryBits
    (inputArity index next selectedCode compilerOutput : ℕ) : ℕ :=
  natBitLength <|
    structuralSummaryWorkBound
      inputArity index next selectedCode compilerOutput

@[simp] private theorem structuralSummaryProgram_oracleFree :
    OracleFree structuralSummaryProgram := by
  rfl

/-! ## Canonical public structural runner -/

private def structuralSummaryTailProgram : NPOracleProgram :=
  linkPrograms structuralSummaryAdapterProgram structuralSummaryProgram

private def structuralCompilerTailProgram : NPOracleProgram :=
  linkPrograms
    (preserveRightProgram selectiveCountCasesProgram)
    structuralSummaryTailProgram

/-- The sole production runner from the public balanced-table request to the
exact structural length/atom response.  Every compiler phase is fixed machine
code; the SAT oracle is absent from the full linked instruction stream. -/
def structuralFormulaProgram : NPOracleProgram :=
  linkPrograms structuralPreludeProgram <|
    linkPrograms structuralCompilerInputAdapterProgram
      structuralCompilerTailProgram

@[simp] theorem structuralFormulaProgram_oracleFree :
    OracleFree structuralFormulaProgram := by
  exact oracleFree_linkPrograms
    structuralPreludeProgram_oracleFree <|
    oracleFree_linkPrograms
      structuralCompilerInputAdapterProgram_oracleFree <|
      oracleFree_linkPrograms
        (preserveRightProgram_oracleFree
          selectiveCountCasesProgram
          selectiveCountCasesProgram_oracleFree) <|
        oracleFree_linkPrograms
          structuralSummaryAdapterProgram_oracleFree
          structuralSummaryProgram_oracleFree

private theorem structuralSummary_value_fits
    (inputArity index next selectedCode compilerOutput : ℕ)
    {value : ℕ}
    (hvalue :
      value ∈ structuralSummaryWorkingValues
        inputArity index next selectedCode compilerOutput) :
    natBitLength value ≤
      structuralSummaryBits
        inputArity index next selectedCode compilerOutput := by
  exact natBitLength_mono <|
    structuralWorkingValue_le hvalue

private def structuralSummaryParsedState
    (machineInputLength inputArity index next selectedCode
      compilerOutput : ℕ) : NPOracleState :=
  let state₀ :=
    initialNPOracleState machineInputLength <|
      structuralSummaryInput
        inputArity index next selectedCode compilerOutput
  let state₁ := (state₀.write 2 (inputArity - index)).jump 1
  let state₂ :=
    (state₁.write 3 <| Nat.pair inputArity <|
      Nat.pair index <| Nat.pair next <|
        Nat.pair selectedCode compilerOutput).jump 2
  let state₃ := (state₂.write 4 inputArity).jump 3
  let state₄ :=
    (state₃.write 5 <| Nat.pair index <| Nat.pair next <|
      Nat.pair selectedCode compilerOutput).jump 4
  let state₅ := (state₄.write 6 index).jump 5
  let state₆ :=
    (state₅.write 7 <| Nat.pair next <|
      Nat.pair selectedCode compilerOutput).jump 6
  let state₇ := (state₆.write 8 next).jump 7
  let state₈ :=
    (state₇.write 9 <| Nat.pair selectedCode compilerOutput).jump 8
  let state₉ := (state₈.write 10 selectedCode).jump 9
  let state₁₀ := (state₉.write 11 compilerOutput).jump 10
  let state₁₁ := (state₁₀.write 12 (inputArity + next)).jump 11
  (state₁₁.write 12 (inputArity + next + 1)).jump 12

private theorem run_structuralSummaryParse
    (machineInputLength inputArity index next selectedCode
      compilerOutput extra : ℕ) :
    runNPOracleProgram structuralSummaryProgram
        (structuralSummaryBits
          inputArity index next selectedCode compilerOutput)
        (12 + extra)
        (initialNPOracleState machineInputLength
          (structuralSummaryInput
            inputArity index next selectedCode compilerOutput)) =
      runNPOracleProgram structuralSummaryProgram
        (structuralSummaryBits
          inputArity index next selectedCode compilerOutput)
        extra
        (structuralSummaryParsedState machineInputLength
          inputArity index next selectedCode compilerOutput) := by
  let maximumBits :=
    structuralSummaryBits
      inputArity index next selectedCode compilerOutput
  have hfits : ∀ {value : ℕ},
      value ∈ structuralSummaryWorkingValues
          inputArity index next selectedCode compilerOutput →
        natBitLength value ≤ maximumBits := by
    intro value hvalue
    exact structuralSummary_value_fits
      inputArity index next selectedCode compilerOutput hvalue
  rw [show 12 + extra = (11 + extra) + 1 by omega]
  rw [run_unpairLeft_instruction
    (value := inputArity - index)
    (by rfl) rfl
    (by simp [initialNPOracleState, structuralSummaryInput])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 11 + extra = (10 + extra) + 1 by omega]
  rw [run_unpairRight_instruction
    (value := Nat.pair inputArity <|
      Nat.pair index <| Nat.pair next <|
        Nat.pair selectedCode compilerOutput)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, structuralSummaryInput])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 10 + extra = (9 + extra) + 1 by omega]
  rw [run_unpairLeft_instruction
    (value := inputArity)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 9 + extra = (8 + extra) + 1 by omega]
  rw [run_unpairRight_instruction
    (value := Nat.pair index <| Nat.pair next <|
      Nat.pair selectedCode compilerOutput)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 8 + extra = (7 + extra) + 1 by omega]
  rw [run_unpairLeft_instruction
    (value := index)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 7 + extra = (6 + extra) + 1 by omega]
  rw [run_unpairRight_instruction
    (value := Nat.pair next <| Nat.pair selectedCode compilerOutput)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 6 + extra = (5 + extra) + 1 by omega]
  rw [run_unpairLeft_instruction
    (value := next)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 5 + extra = (4 + extra) + 1 by omega]
  rw [run_unpairRight_instruction
    (value := Nat.pair selectedCode compilerOutput)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 4 + extra = (3 + extra) + 1 by omega]
  rw [run_unpairLeft_instruction
    (value := selectedCode)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 3 + extra = (2 + extra) + 1 by omega]
  rw [run_unpairRight_instruction
    (value := compilerOutput)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 2 + extra = (1 + extra) + 1 by omega]
  rw [run_add_instruction
    (value := inputArity + next)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rw [show 1 + extra = extra + 1 by omega]
  rw [run_increment_instruction
    (value := inputArity + next + 1)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hfits (by simp [structuralSummaryWorkingValues]))]
  rfl

private theorem run_structuralSummaryFinish
    (maximumBits inputArity taggedAtom length : ℕ)
    (state : NPOracleState)
    (hpc : state.pc = 36)
    (harity : state.registers 4 = inputArity)
    (htag : state.registers 14 = taggedAtom)
    (hlength : state.registers 12 = length)
    (hatomBits :
      natBitLength (Nat.pair inputArity taggedAtom) ≤ maximumBits)
    (houtputBits :
      natBitLength
          (Nat.pair length (Nat.pair inputArity taggedAtom)) ≤
        maximumBits) :
    runNPOracleProgram structuralSummaryProgram
        maximumBits 3 state =
      some (Nat.pair length (Nat.pair inputArity taggedAtom)) := by
  rw [show 3 = 2 + 1 by omega]
  rw [run_pair_instruction
    (value := Nat.pair inputArity taggedAtom)
    (by rfl) hpc
    (by simp [harity, htag])
    hatomBits]
  rw [show 2 = 1 + 1 by omega]
  rw [run_pair_instruction
    (value := Nat.pair length (Nat.pair inputArity taggedAtom))
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        hlength])
    houtputBits]
  exact run_halt_instruction (fuel := 0)
    (by rfl) rfl
    (by simp [NPOracleState.write, NPOracleState.jump])
    houtputBits

set_option maxHeartbeats 800000 in
-- The proof follows both response branches through the encoded node payload.
private theorem run_structuralSummaryProgram
    (machineInputLength inputArity index next selectedCode
      compilerOutput : ℕ) :
    runNPOracleProgram structuralSummaryProgram
        (structuralSummaryBits
          inputArity index next selectedCode compilerOutput)
        (structuralSummaryFuel inputArity index selectedCode)
        (initialNPOracleState machineInputLength
          (structuralSummaryInput
            inputArity index next selectedCode compilerOutput)) =
      some
        (structuralSummaryOutput
          inputArity index next selectedCode compilerOutput) := by
  let maximumBits :=
    structuralSummaryBits
      inputArity index next selectedCode compilerOutput
  let parsed :=
    structuralSummaryParsedState machineInputLength
      inputArity index next selectedCode compilerOutput
  have hfits : ∀ {value : ℕ},
      value ∈ structuralSummaryWorkingValues
          inputArity index next selectedCode compilerOutput →
        natBitLength value ≤ maximumBits := by
    intro value hvalue
    exact structuralSummary_value_fits
      inputArity index next selectedCode compilerOutput hvalue
  have hstructuralOutputBits :
      natBitLength
          (structuralSummaryOutput
            inputArity index next selectedCode compilerOutput) ≤
        maximumBits :=
    hfits (by simp [structuralSummaryWorkingValues])
  have hparsed :
      parsed.pc = 12 ∧
      parsed.registers 2 = inputArity - index ∧
      parsed.registers 4 = inputArity ∧
      parsed.registers 6 = index ∧
      parsed.registers 8 = next ∧
      parsed.registers 10 = selectedCode ∧
      parsed.registers 11 = compilerOutput ∧
      parsed.registers 12 = inputArity + next + 1 ∧
      parsed.registers 13 = 0 := by
    simp [parsed, structuralSummaryParsedState,
      initialNPOracleState, NPOracleState.write,
      NPOracleState.jump]
  rcases hparsed with
    ⟨hpc, hgap, harity, hindex, hnext, hselectedCode,
      hcompilerOutput, hlength, hzero⟩
  by_cases hinput : inputArity - index = 0
  · by_cases hselected : selectedCode = 0
    · rw [show structuralSummaryFuel inputArity index selectedCode =
          12 + 12 by
        simp [structuralSummaryFuel, hinput, hselected]]
      rw [run_structuralSummaryParse]
      rw [show 12 = 11 + 1 by omega]
      rw [run_branchZero_instruction (by rfl) hpc]
      rw [show parsed.registers 2 = 0 by
        exact hgap.trans hinput, if_pos rfl]
      rw [show 11 = 10 + 1 by omega]
      rw [run_branchZero_instruction (by rfl) rfl]
      rw [show (parsed.jump 20).registers 10 = 0 by
        simpa [NPOracleState.jump, hselected] using hselectedCode,
        if_pos rfl]
      rw [show 10 = 9 + 1 by omega]
      rw [run_set_instruction (value := 0)
        (by rfl) rfl
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 9 = 8 + 1 by omega]
      rw [run_set_instruction (value := 1)
        (by rfl) rfl
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 8 = 7 + 1 by omega]
      rw [run_pair_instruction
        (value := Nat.pair 0 1)
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 7 = 6 + 1 by omega]
      rw [run_add_instruction
        (value := inputArity + compilerOutput)
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            harity, hcompilerOutput])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 6 = 5 + 1 by omega]
      rw [run_add_instruction
        (value := inputArity + compilerOutput)
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 5 = 4 + 1 by omega]
      rw [run_pair_instruction
        (value :=
          Nat.pair (inputArity + compilerOutput) (Nat.pair 0 1))
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 4 = 3 + 1 by omega]
      rw [run_pair_instruction
        (value := Nat.pair 1 <|
          Nat.pair (inputArity + compilerOutput) (Nat.pair 0 1))
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      have hsummary :
          structuralSummaryOutput
              inputArity index next selectedCode compilerOutput =
            Nat.pair (inputArity + next + 1)
              (Nat.pair inputArity
                (Nat.pair 1
                  (Nat.pair (inputArity + compilerOutput)
                    (Nat.pair 0 1)))) := by
        simp [structuralSummaryOutput, structuralSummaryAtom,
          structuralRawNodeAtom, hinput, hselected]
      rw [hsummary]
      apply run_structuralSummaryFinish maximumBits
      · rfl
      · simpa [NPOracleState.write, NPOracleState.jump] using harity
      · simp [NPOracleState.write, NPOracleState.jump]
      · simpa [NPOracleState.write, NPOracleState.jump] using hlength
      · exact hfits (by simp [structuralSummaryWorkingValues])
      · simpa only [← hsummary] using hstructuralOutputBits
    · rw [show structuralSummaryFuel inputArity index selectedCode =
          12 + 13 by
        simp [structuralSummaryFuel, hinput, hselected]]
      rw [run_structuralSummaryParse]
      let selectedState₀ := parsed.jump 20
      let selectedState₁ := selectedState₀.jump 21
      let selectedState₂ :=
        (selectedState₁.write 16 (Nat.unpair selectedCode).2).jump 22
      let selectedState₃ :=
        (selectedState₂.write 17 (index - inputArity)).jump 23
      let selectedState₄ :=
        (selectedState₃.write 18
          (inputArity + (index - inputArity))).jump 24
      let selectedState₅ :=
        (selectedState₄.write 18
          (inputArity + (index - inputArity))).jump 25
      let selectedState₆ :=
        (selectedState₅.write 19 <| Nat.pair
          (inputArity + (index - inputArity))
          (Nat.unpair selectedCode).2).jump 26
      let selectedState₇ := (selectedState₆.write 20 1).jump 27
      let selectedState₈ :=
        (selectedState₇.write 14 <| Nat.pair 1 <| Nat.pair
          (inputArity + (index - inputArity))
          (Nat.unpair selectedCode).2).jump 28
      rw [show 13 = 12 + 1 by omega]
      rw [run_branchZero_instruction (by rfl) hpc]
      rw [show parsed.registers 2 = 0 by
        exact hgap.trans hinput, if_pos rfl]
      rw [show 12 = 11 + 1 by omega]
      rw [run_branchZero_instruction (by rfl) rfl]
      rw [show (parsed.jump 20).registers 10 = selectedCode by
        simpa [NPOracleState.jump] using hselectedCode,
        if_neg hselected]
      rw [show 11 = 10 + 1 by omega]
      rw [run_unpairRight_instruction
        (value := (Nat.unpair selectedCode).2)
        (by rfl) rfl
        (by
          simp [NPOracleState.jump, hselectedCode])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 10 = 9 + 1 by omega]
      rw [run_subtract_instruction
        (value := index - inputArity)
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            hindex, harity])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 9 = 8 + 1 by omega]
      rw [run_add_instruction
        (value := inputArity + (index - inputArity))
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump, harity])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 8 = 7 + 1 by omega]
      rw [run_add_instruction
        (value := inputArity + (index - inputArity))
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump,
          hzero])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 7 = 6 + 1 by omega]
      rw [run_pair_instruction
        (value := Nat.pair
          (inputArity + (index - inputArity))
          (Nat.unpair selectedCode).2)
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 6 = 5 + 1 by omega]
      rw [run_set_instruction (value := 1)
        (by rfl) rfl
        (hfits (by simp [structuralSummaryWorkingValues]))]
      rw [show 5 = 4 + 1 by omega]
      rw [run_pair_instruction
        (value := Nat.pair 1 <| Nat.pair
          (inputArity + (index - inputArity))
          (Nat.unpair selectedCode).2)
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump])
        (hfits (by simp [structuralSummaryWorkingValues]))]
      change
        runNPOracleProgram structuralSummaryProgram maximumBits 4
            selectedState₈ =
          some
            (structuralSummaryOutput
              inputArity index next selectedCode compilerOutput)
      rw [show 4 = 3 + 1 by omega]
      rw [run_branchZero_instruction (by rfl) rfl]
      rw [show selectedState₈.registers 13 = 0 by
          simp [selectedState₈, selectedState₇, selectedState₆,
            selectedState₅, selectedState₄, selectedState₃,
            selectedState₂, selectedState₁, selectedState₀,
            NPOracleState.write, NPOracleState.jump, hzero],
        if_pos rfl]
      have hselectedArity :
          selectedState₈.registers 4 = inputArity := by
        simpa [selectedState₈, selectedState₇, selectedState₆,
          selectedState₅, selectedState₄, selectedState₃,
          selectedState₂, selectedState₁, selectedState₀,
          NPOracleState.write, NPOracleState.jump] using harity
      have hselectedTag :
          selectedState₈.registers 14 =
            Nat.pair 1 (Nat.pair
              (inputArity + (index - inputArity))
              (Nat.unpair selectedCode).2) := by
        simp [selectedState₈, NPOracleState.write,
          NPOracleState.jump]
      have hselectedLength :
          selectedState₈.registers 12 =
            inputArity + next + 1 := by
        simpa [selectedState₈, selectedState₇, selectedState₆,
          selectedState₅, selectedState₄, selectedState₃,
          selectedState₂, selectedState₁, selectedState₀,
          NPOracleState.write, NPOracleState.jump] using hlength
      have hsummary :
          structuralSummaryOutput
              inputArity index next selectedCode compilerOutput =
            Nat.pair (inputArity + next + 1)
              (Nat.pair inputArity
                (Nat.pair 1
                  (Nat.pair
                    (inputArity + (index - inputArity))
                    (Nat.unpair selectedCode).2))) := by
        simp [structuralSummaryOutput, structuralSummaryAtom,
          structuralRawNodeAtom, hinput, hselected]
      rw [hsummary]
      apply run_structuralSummaryFinish maximumBits
      · rfl
      · exact hselectedArity
      · exact hselectedTag
      · exact hselectedLength
      · exact hfits (by simp [structuralSummaryWorkingValues])
      · simpa only [← hsummary] using hstructuralOutputBits
  · rw [show structuralSummaryFuel inputArity index selectedCode =
        12 + 7 by
      simp [structuralSummaryFuel, hinput]]
    rw [run_structuralSummaryParse]
    let tautologyState₀ := parsed.jump 13
    let tautologyState₁ := (tautologyState₀.write 13 0).jump 14
    let tautologyState₂ :=
      (tautologyState₁.write 14 (Nat.pair 0 index)).jump 15
    rw [show 7 = 6 + 1 by omega]
    rw [run_branchZero_instruction (by rfl) hpc]
    rw [show parsed.registers 2 = inputArity - index by
      exact hgap, if_neg hinput]
    rw [show 6 = 5 + 1 by omega]
    rw [run_set_instruction (value := 0)
      (by rfl) rfl
      (hfits (by simp [structuralSummaryWorkingValues]))]
    rw [show 5 = 4 + 1 by omega]
    rw [run_pair_instruction
      (value := Nat.pair 0 index)
      (by rfl) rfl
      (by simp [NPOracleState.write, NPOracleState.jump, hindex])
      (hfits (by simp [structuralSummaryWorkingValues]))]
    change
      runNPOracleProgram structuralSummaryProgram maximumBits 4
          tautologyState₂ =
        some
          (structuralSummaryOutput
            inputArity index next selectedCode compilerOutput)
    rw [show 4 = 3 + 1 by omega]
    rw [run_branchZero_instruction (by rfl) rfl]
    rw [show tautologyState₂.registers 13 = 0 by
        simp [tautologyState₂, tautologyState₁,
          NPOracleState.write, NPOracleState.jump],
      if_pos rfl]
    have hsummary :
        structuralSummaryOutput
            inputArity index next selectedCode compilerOutput =
          Nat.pair (inputArity + next + 1)
            (Nat.pair inputArity (Nat.pair 0 index)) := by
      simp [structuralSummaryOutput, structuralSummaryAtom,
        hinput]
    rw [hsummary]
    apply run_structuralSummaryFinish maximumBits
    · rfl
    · simpa [tautologyState₂, tautologyState₁, tautologyState₀,
        NPOracleState.write, NPOracleState.jump] using harity
    · simp [tautologyState₂, NPOracleState.write,
        NPOracleState.jump]
    · simpa [tautologyState₂, tautologyState₁, tautologyState₀,
        NPOracleState.write, NPOracleState.jump] using hlength
    · exact hfits (by simp [structuralSummaryWorkingValues])
    · simpa only [← hsummary] using hstructuralOutputBits

private def structuralCompilerSummaryInput
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  let inputArity := descriptionWidth width bound
  let compiled :=
    selectiveCompileTableBoundedOracleVerifier
      outputs width count bound (index - inputArity)
  structuralSummaryInput inputArity index compiled.state.next
    (selectiveSelectedCode compiled.state.selected) compiled.output

private theorem structuralSummaryAdapterOutput_eq_compilerSummary
    (outputs : List ℕ) (width count bound index : ℕ) :
    let inputArity := descriptionWidth width bound
    let compiled :=
      selectiveCompileTableBoundedOracleVerifier
        outputs width count bound (index - inputArity)
    structuralSummaryAdapterOutput
        (selectiveWireCode compiled) inputArity index =
      structuralCompilerSummaryInput
        outputs width count bound index := by
  simp [structuralSummaryAdapterOutput,
    structuralCompilerSummaryInput, selectiveWireCode,
    selectiveStateCode, selectiveEmitStateCode]

private theorem structuralCompilerSummaryOutput_eq
    (outputs : List ℕ) (width count bound index : ℕ) :
    let inputArity := descriptionWidth width bound
    let compiled :=
      selectiveCompileTableBoundedOracleVerifier
        outputs width count bound (index - inputArity)
    structuralSummaryOutput inputArity index compiled.state.next
        (selectiveSelectedCode compiled.state.selected) compiled.output =
      structuralFormulaResponseCode outputs width count bound index := by
  let inputArity := descriptionWidth width bound
  let compiled :=
    selectiveCompileTableBoundedOracleVerifier
      outputs width count bound (index - inputArity)
  have hrefinement :=
    selectiveStructuralFormulaResponse_eq
      outputs width count bound index
  have hrefinementCode :=
    congrArg (fun response : ℕ × ℕ =>
      Nat.pair response.1 response.2) hrefinement
  change
    structuralSummaryOutput inputArity index compiled.state.next
        (selectiveSelectedCode compiled.state.selected) compiled.output =
      Nat.pair
        (tableBoundedOracleStructuralFormulaLength
          outputs width count bound)
        (tableBoundedOracleStructuralFormulaAtomAt
          outputs width count bound index)
  rw [← hrefinementCode]
  by_cases hinput : index < inputArity
  · have hgap : inputArity - index ≠ 0 := by omega
    simp [selectiveStructuralFormulaResponse, structuralSummaryOutput,
      structuralSummaryAtom, inputArity,
      compiled, hinput, hgap,
      CircuitInputClauseBalancedCall.circuitInputFormulaClauseTautologyAtom]
  · have hgap : inputArity - index = 0 := by omega
    cases hselected : compiled.state.selected with
    | none =>
        simp [selectiveStructuralFormulaResponse, structuralSummaryOutput,
          structuralSummaryAtom, structuralRawNodeAtom,
          selectiveSelectedCode, inputArity, compiled,
          hinput, hgap, hselected,
          CircuitInputClauseBalancedCall.circuitInputFormulaClauseNodeAtom,
          circuitInputClauseRequest,
          CircuitInputCNF.circuitInputGateVariable,
          TseitinCNF.gateVariable,
          rawCircuitNodeCode]
    | some node =>
        have hselectedCode :
            Nat.pair 1 (rawCircuitNodeCode node) ≠ 0 := by
          have hleft := Nat.left_le_pair 1 (rawCircuitNodeCode node)
          omega
        simp [selectiveStructuralFormulaResponse, structuralSummaryOutput,
          structuralSummaryAtom, structuralRawNodeAtom,
          selectiveSelectedCode, inputArity, compiled,
          hinput, hgap, hselected, hselectedCode,
          CircuitInputClauseBalancedCall.circuitInputFormulaClauseNodeAtom,
          circuitInputClauseRequest,
          CircuitInputCNF.circuitInputGateVariable,
          TseitinCNF.gateVariable]

private theorem run_structuralSummaryProgram_eq_response
    (machineInputLength : ℕ) (outputs : List ℕ)
    (width count bound index : ℕ) :
    let inputArity := descriptionWidth width bound
    let compiled :=
      selectiveCompileTableBoundedOracleVerifier
        outputs width count bound (index - inputArity)
    runNPOracleProgram structuralSummaryProgram
        (structuralSummaryBits inputArity index compiled.state.next
          (selectiveSelectedCode compiled.state.selected) compiled.output)
        (structuralSummaryFuel inputArity index
          (selectiveSelectedCode compiled.state.selected))
        (initialNPOracleState machineInputLength
          (structuralCompilerSummaryInput
            outputs width count bound index)) =
      some
        (structuralFormulaResponseCode
          outputs width count bound index) := by
  dsimp only
  rw [show structuralCompilerSummaryInput
      outputs width count bound index =
    structuralSummaryInput (descriptionWidth width bound) index
      (selectiveCompileTableBoundedOracleVerifier outputs width count bound
        (index - descriptionWidth width bound)).state.next
      (selectiveSelectedCode
        (selectiveCompileTableBoundedOracleVerifier outputs width count bound
          (index - descriptionWidth width bound)).state.selected)
      (selectiveCompileTableBoundedOracleVerifier outputs width count bound
        (index - descriptionWidth width bound)).output by
    rfl]
  rw [run_structuralSummaryProgram]
  exact congrArg some <|
    structuralCompilerSummaryOutput_eq
      outputs width count bound index

/-! The public linker proof below isolates the one remaining compiler
execution obligation.  Callers consume it with the compiler's own run as a
named premise, and consume the closed runner theorem once the nested compiler
trace discharges that premise. -/

private def structuralFormulaPipelineBitBudgets
    (machineInputLength : ℕ) (outputs : List ℕ)
    (width count bound index compilerBits : ℕ) : List ℕ :=
  let inputArity := descriptionWidth width bound
  let compiled :=
    selectiveCompileTableBoundedOracleVerifier
      outputs width count bound (index - inputArity)
  let compilerResult := selectiveWireCode compiled
  let summaryContext := Nat.pair inputArity index
  [ natBitLength machineInputLength
  , structuralPreludeBits
      machineInputLength outputs width count bound index
  , structuralCompilerInputAdapterBits
      outputs width count bound index
  , preserveRightBits compilerBits
      (structuralCompilerCoreInput
        outputs width count bound index)
      summaryContext compilerResult
  , structuralSummaryAdapterBits
      compilerResult inputArity index
  , structuralSummaryBits inputArity index compiled.state.next
      (selectiveSelectedCode compiled.state.selected) compiled.output
  ]

/-- Width of the whole pointwise pipeline at one compiler width. -/
def structuralFormulaPipelineBits
    (machineInputLength : ℕ) (outputs : List ℕ)
    (width count bound index compilerBits : ℕ) : ℕ :=
  (structuralFormulaPipelineBitBudgets machineInputLength outputs
    width count bound index compilerBits).foldr max 0

/-- Fuel of the whole pointwise pipeline at one compiler fuel. -/
def structuralFormulaPipelineFuel
    (outputs : List ℕ) (width count bound index compilerFuel : ℕ) : ℕ :=
  let inputArity := descriptionWidth width bound
  let compiled :=
    selectiveCompileTableBoundedOracleVerifier
      outputs width count bound (index - inputArity)
  let summaryFuel :=
    structuralSummaryFuel inputArity index
      (selectiveSelectedCode compiled.state.selected)
  let summaryTailFuel :=
    linkFuel structuralSummaryProgram 17 summaryFuel
  let compilerTailFuel :=
    linkFuel structuralSummaryTailProgram
      (preserveRightFuel compilerFuel) summaryTailFuel
  let compilerPipelineFuel :=
    linkFuel structuralCompilerTailProgram 33 compilerTailFuel
  linkFuel
    (linkPrograms structuralCompilerInputAdapterProgram
      structuralCompilerTailProgram)
    (structuralPreludeFuel outputs bound) compilerPipelineFuel

set_option maxHeartbeats 2000000 in
-- Linking the nested compiler forces Lean to elaborate its full resource type.
/-- **The pointwise structural runner, modulo the compiler's own run.**  Every
stage but the nested structural compiler is executed here; the compiler's run
at the module's private ABI frame is the sole premise. -/
theorem run_structuralFormulaProgram_of_compiler_run
    (machineInputLength : ℕ) (outputs : List ℕ)
    (width count bound index compilerBits compilerFuel : ℕ)
    (hcompiler :
      let inputArity := descriptionWidth width bound
      let compiled :=
        selectiveCompileTableBoundedOracleVerifier
          outputs width count bound (index - inputArity)
      runNPOracleProgram selectiveCountCasesProgram
          compilerBits compilerFuel
          (initialNPOracleState machineInputLength <|
            structuralCompilerCoreInput
              outputs width count bound index) =
        some (selectiveWireCode compiled)) :
    runNPOracleProgram structuralFormulaProgram
        (structuralFormulaPipelineBits machineInputLength outputs
          width count bound index compilerBits)
        (structuralFormulaPipelineFuel
          outputs width count bound index compilerFuel)
        (initialNPOracleState machineInputLength <|
          structuralFormulaRequestCode
            outputs width count bound index) =
      some
        (structuralFormulaResponseCode
          outputs width count bound index) := by
  let inputArity := descriptionWidth width bound
  let compiled :=
    selectiveCompileTableBoundedOracleVerifier
      outputs width count bound (index - inputArity)
  let compilerInput :=
    structuralCompilerCoreInput outputs width count bound index
  let compilerResult := selectiveWireCode compiled
  let summaryContext := Nat.pair inputArity index
  let preservedOutput := Nat.pair compilerResult summaryContext
  let summaryInput :=
    structuralCompilerSummaryInput outputs width count bound index
  let preludeBits :=
    structuralPreludeBits
      machineInputLength outputs width count bound index
  let adapterBits :=
    structuralCompilerInputAdapterBits
      outputs width count bound index
  let preservedBits :=
    preserveRightBits compilerBits
      compilerInput summaryContext compilerResult
  let summaryAdapterBits :=
    structuralSummaryAdapterBits compilerResult inputArity index
  let summaryBits :=
    structuralSummaryBits inputArity index compiled.state.next
      (selectiveSelectedCode compiled.state.selected) compiled.output
  let maximumBits :=
    structuralFormulaPipelineBits machineInputLength outputs
      width count bound index compilerBits
  let summaryFuel :=
    structuralSummaryFuel inputArity index
      (selectiveSelectedCode compiled.state.selected)
  let summaryTailFuel :=
    linkFuel structuralSummaryProgram 17 summaryFuel
  let compilerTailFuel :=
    linkFuel structuralSummaryTailProgram
      (preserveRightFuel compilerFuel) summaryTailFuel
  let compilerPipelineFuel :=
    linkFuel structuralCompilerTailProgram 33 compilerTailFuel
