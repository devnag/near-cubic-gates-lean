import Proof.Supplier.BoundedOracleStructuralSelectiveCompiler
import Proof.Foundations.CanonicalBinaryProgram
import Proof.Foundations.CanonicalEncodedListLengthProgram
import Proof.MachineModel.CanonicalNatDecodeProgram
import Proof.MachineModel.CanonicalProjectedRandomBitProgram
import Proof.MachineModel.CanonicalThreeCNFLiteralProgram
import Proof.Circuits.CallableRelocation
import Proof.MachineModel.PreserveRightProgram

/-!
# Fixed selective bounded-oracle structural program

This module is the executable boundary for the table-driven structural
compiler.  A request contains exactly one formula index and the public
projection-table context.  The table is converted once from its canonical
balanced representation to the internal tagged traversal spine; no decoded
list, node schedule, formula, certificate, or semantic callback crosses the
machine boundary.
-/

namespace NearCubicWires.BoundedOracleStructuralSelectiveProgram

open NearCubicWires
open NearCubicWires.BoundedOracleStructuralCircuit
open NearCubicWires.BoundedOracleStructuralFormulaTable
open NearCubicWires.BoundedOracleStructuralSelectiveCompiler
open NearCubicWires.OuterPCPRecovery
open NearCubicWires.CanonicalBinary
open NearCubicWires.CanonicalBinaryProgram
open NearCubicWires.CanonicalEncodedListLengthProgram
open NearCubicWires.CanonicalNatDecodeProgram
open NearCubicWires.CanonicalProjectedRandomBitProgram
open NearCubicWires.CanonicalThreeCNFLiteralProgram
open NearCubicWires.CallableRelocation
open NearCubicWires.CircuitInputClauseProgram
open NearCubicWires.ExecutableInterfaces
open NearCubicWires.PolynomialClock
open NearCubicWires.PreserveRightProgram
open NearCubicWires.VerifiedLinker

/-- The native callee body generated by `balancedRangeRequestAtom`. -/
def structuralFormulaRequestCode
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  Nat.pair index <|
    tableBoundedOracleStructuralFormulaContext outputs width count bound

/-- Exact paired result returned by the fixed pointwise structural callee. -/
def structuralFormulaResponseCode
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  Nat.pair
    (tableBoundedOracleStructuralFormulaLength outputs width count bound)
    (tableBoundedOracleStructuralFormulaAtomAt
      outputs width count bound index)

private def structuralShapeCode
    (width count bound : ℕ) : ℕ :=
  Nat.pair width (Nat.pair count bound)

private def structuralMetadataCode
    (width count bound index : ℕ) : ℕ :=
  Nat.pair index (structuralShapeCode width count bound)

/-- Internal controller input after the one canonical balanced-to-tagged
conversion.  The tagged table is traversal state, not a second public codec. -/
private def structuralPreparedCode
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  Nat.pair (encodeTaggedList outputs)
    (structuralMetadataCode width count bound index)

/-! ## Public-context preparation -/

/-- Isolate the balanced table as the left field consumed by the shared
balanced-to-tagged program, preserving the complete scalar metadata on the
right. -/
private def structuralRequestAdapterProgram : NPOracleProgram :=
  [ .unpairLeft 0 2 1
  , .unpairRight 0 3 2
  , .unpairLeft 3 4 3
  , .unpairRight 3 5 4
  , .pair 2 5 6 5
  , .pair 4 6 0 6
  , .halt 0
  ]

private def structuralAdapterPreparedCode
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  Nat.pair (encodeBalancedList outputs)
    (structuralMetadataCode width count bound index)

private def structuralRequestAdapterBound
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  max
    (structuralFormulaRequestCode outputs width count bound index)
    (structuralAdapterPreparedCode outputs width count bound index)

private def structuralRequestAdapterBits
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  natBitLength <|
    structuralRequestAdapterBound outputs width count bound index

@[simp] private theorem structuralRequestAdapterProgram_oracleFree :
    OracleFree structuralRequestAdapterProgram := by
  rfl

private theorem run_structuralRequestAdapterProgram
    (inputLength : ℕ) (outputs : List ℕ)
    (width count bound index : ℕ) :
    runNPOracleProgram structuralRequestAdapterProgram
        (structuralRequestAdapterBits outputs width count bound index) 7
        (initialNPOracleState inputLength
          (structuralFormulaRequestCode
            outputs width count bound index)) =
      some
        (structuralAdapterPreparedCode
          outputs width count bound index) := by
  let request :=
    structuralFormulaRequestCode outputs width count bound index
  let shape := structuralShapeCode width count bound
  let metadata := structuralMetadataCode width count bound index
  let prepared :=
    structuralAdapterPreparedCode outputs width count bound index
  let boundValue :=
    structuralRequestAdapterBound outputs width count bound index
  let maximumBits :=
    structuralRequestAdapterBits outputs width count bound index
  have hrequest : request ≤ boundValue := Nat.le_max_left _ _
  have hprepared : prepared ≤ boundValue := Nat.le_max_right _ _
  have hbits : ∀ {value : ℕ}, value ≤ boundValue →
      natBitLength value ≤ maximumBits := by
    intro value hvalue
    exact natBitLength_mono hvalue
  have hindex : index ≤ boundValue := by
    exact (Nat.left_le_pair index
      (tableBoundedOracleStructuralFormulaContext
        outputs width count bound)).trans hrequest
  have hcontext :
      tableBoundedOracleStructuralFormulaContext
          outputs width count bound ≤ boundValue := by
    exact (Nat.right_le_pair index
      (tableBoundedOracleStructuralFormulaContext
        outputs width count bound)).trans hrequest
  have htable : encodeBalancedList outputs ≤ boundValue := by
    exact
      (Nat.left_le_pair (encodeBalancedList outputs) shape).trans hcontext
  have hshape : shape ≤ boundValue := by
    exact
      (Nat.right_le_pair (encodeBalancedList outputs) shape).trans hcontext
  have hmetadata : metadata ≤ boundValue := by
    exact
      (Nat.right_le_pair (encodeBalancedList outputs) metadata).trans
        hprepared
  rw [show (7 : ℕ) = 6 + 1 by omega]
  rw [run_unpairLeft_instruction (value := index)
    (by rfl) rfl
    (by simp [initialNPOracleState,
      structuralFormulaRequestCode])
    (hbits hindex)]
  rw [show (6 : ℕ) = 5 + 1 by omega]
  rw [run_unpairRight_instruction
    (value :=
      tableBoundedOracleStructuralFormulaContext
        outputs width count bound)
    (by rfl) rfl
    (by simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump, structuralFormulaRequestCode])
    (hbits hcontext)]
  rw [show (5 : ℕ) = 4 + 1 by omega]
  rw [run_unpairLeft_instruction
    (value := encodeBalancedList outputs)
    (by rfl) rfl
    (by simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump,
      tableBoundedOracleStructuralFormulaContext])
    (hbits htable)]
  rw [show (4 : ℕ) = 3 + 1 by omega]
  rw [run_unpairRight_instruction (value := shape)
    (by rfl) rfl
    (by simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump,
      tableBoundedOracleStructuralFormulaContext,
      shape, structuralShapeCode])
    (hbits hshape)]
  rw [show (3 : ℕ) = 2 + 1 by omega]
  rw [run_pair_instruction (value := metadata)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, metadata, structuralMetadataCode]
      rfl)
    (hbits hmetadata)]
  rw [show (2 : ℕ) = 1 + 1 by omega]
  rw [run_pair_instruction (value := prepared)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, prepared,
        structuralAdapterPreparedCode]
      rfl)
    (hbits hprepared)]
  exact run_halt_instruction (fuel := 0)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump]
      rfl)
    (hbits hprepared)

/-! ## Canonical table preparation -/

/-- Parse the public request and convert its balanced table exactly once.  The
tagged value is private traversal state; every subsequent controller stage
shares this one representation. -/
private def structuralPreparationProgram : NPOracleProgram :=
  linkPrograms structuralRequestAdapterProgram <|
    preserveRightProgram balancedBitsToTaggedProgram

private def structuralPreparationFuel
    (outputs : List ℕ) : ℕ :=
  linkFuel (preserveRightProgram balancedBitsToTaggedProgram)
    7
    (preserveRightFuel (balancedBitsToTaggedFuel outputs))

private def structuralPreparationBits
    (inputLength : ℕ) (outputs : List ℕ)
    (width count bound index : ℕ) : ℕ :=
  max (natBitLength inputLength) <|
    max
      (structuralRequestAdapterBits outputs width count bound index)
      (preserveRightBits
        (balancedBitsToTaggedBits inputLength outputs)
        (encodeBalancedList outputs)
        (structuralMetadataCode width count bound index)
        (encodeTaggedList outputs))

@[simp] private theorem structuralPreparationProgram_oracleFree :
    OracleFree structuralPreparationProgram := by
  apply oracleFree_linkPrograms
  · exact structuralRequestAdapterProgram_oracleFree
  · exact preserveRightProgram_oracleFree _
      balancedBitsToTaggedProgram_oracleFree

private theorem run_structuralPreparationProgram
    (inputLength : ℕ) (outputs : List ℕ)
    (width count bound index : ℕ) :
    runNPOracleProgram structuralPreparationProgram
        (structuralPreparationBits
          inputLength outputs width count bound index)
        (structuralPreparationFuel outputs)
        (initialNPOracleState inputLength
          (structuralFormulaRequestCode
            outputs width count bound index)) =
      some
        (structuralPreparedCode
          outputs width count bound index) := by
  let metadata := structuralMetadataCode width count bound index
  let balanced := encodeBalancedList outputs
  let tagged := encodeTaggedList outputs
  let adapterBits :=
    structuralRequestAdapterBits outputs width count bound index
  let conversionBits :=
    balancedBitsToTaggedBits inputLength outputs
  let preservedBits :=
    preserveRightBits conversionBits balanced metadata tagged
  let maximumBits :=
    structuralPreparationBits
      inputLength outputs width count bound index
  have hlengthBits : natBitLength inputLength ≤ maximumBits :=
    Nat.le_max_left _ _
  have hadapterBits : adapterBits ≤ maximumBits := by
    exact (Nat.le_max_left _ _).trans (Nat.le_max_right _ _)
  have hpreservedBits : preservedBits ≤ maximumBits := by
    exact (Nat.le_max_right _ _).trans (Nat.le_max_right _ _)
  have hpositive : 1 ≤ maximumBits := by
    exact (by
      unfold natBitLength
      omega : 1 ≤ natBitLength inputLength).trans hlengthBits
  have hadapter :
      runNPOracleProgram structuralRequestAdapterProgram maximumBits 7
          (initialNPOracleState inputLength
            (structuralFormulaRequestCode
              outputs width count bound index)) =
        some
          (structuralAdapterPreparedCode
            outputs width count bound index) :=
    run_bits_mono
      (run_structuralRequestAdapterProgram inputLength outputs
        width count bound index)
      hadapterBits
  have hconversion :
      runNPOracleProgram balancedBitsToTaggedProgram conversionBits
          (balancedBitsToTaggedFuel outputs)
          (initialNPOracleState inputLength balanced) =
        some tagged := by
    simpa only [conversionBits, balanced, tagged] using
      run_balancedBitsToTaggedProgram inputLength outputs
  have hpreservedOwn :
      runNPOracleProgram
          (preserveRightProgram balancedBitsToTaggedProgram)
          preservedBits
          (preserveRightFuel (balancedBitsToTaggedFuel outputs))
          (initialNPOracleState inputLength
            (Nat.pair balanced metadata)) =
        some (Nat.pair tagged metadata) :=
    run_preserveRightProgram balancedBitsToTaggedProgram
      inputLength conversionBits
      (balancedBitsToTaggedFuel outputs)
      balanced metadata tagged hconversion
  have hpreserved :
      runNPOracleProgram
          (preserveRightProgram balancedBitsToTaggedProgram)
          maximumBits
          (preserveRightFuel (balancedBitsToTaggedFuel outputs))
          (initialNPOracleState inputLength
            (structuralAdapterPreparedCode
              outputs width count bound index)) =
        some
          (structuralPreparedCode
            outputs width count bound index) := by
    have hwiden := run_bits_mono hpreservedOwn hpreservedBits
    simpa only [structuralAdapterPreparedCode,
      structuralPreparedCode, balanced, tagged, metadata] using hwiden
  exact run_linkPrograms hpositive hlengthBits hadapter hpreserved

/-! ## Native shape and target scheduler -/

def structuralInputArity (width bound : ℕ) : ℕ :=
  descriptionWidth width bound

def structuralRowWidth (width bound : ℕ) : ℕ :=
  6 + 2 * (width + bound + 1)

private def structuralControllerContext
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  let inputArity := structuralInputArity width bound
  let target := index - inputArity
  let inputGap := inputArity - index
  Nat.pair (encodeTaggedList outputs) <|
    Nat.pair inputGap <|
      Nat.pair inputArity <|
        Nat.pair target <|
          structuralMetadataCode width count bound index

/-- Parse the private prepared value and derive
`descriptionWidth = (bound + 1) * rowWidth` with native addition and shifting.
`inputGap` is retained so the next stage can dispatch input tautologies without
an equality or comparison side channel. -/
private def structuralShapeProgram : NPOracleProgram :=
  [ .unpairLeft 0 2 1
  , .unpairRight 0 3 2
  , .unpairLeft 3 4 3
  , .unpairRight 3 5 4
  , .unpairLeft 5 6 5
  , .unpairRight 5 7 6
  , .unpairLeft 7 8 7
  , .unpairRight 7 9 8
  , .set 10 1 9
  , .add 6 9 11 10
  , .increment 11 11
  , .shiftLeft 11 1 12 12
  , .set 14 6 13
  , .add 12 14 13 14
  , .copy 9 15 15
  , .increment 15 16
  , .set 16 0 17
  , .branchZero 15 21 18
  , .add 16 13 16 19
  , .decrement 15 20
  , .branchZero 10 17 17
  , .subtract 4 16 18 22
  , .subtract 16 4 19 23
  , .pair 4 5 20 24
  , .pair 18 20 21 25
  , .pair 16 21 22 26
  , .pair 19 22 23 27
  , .pair 2 23 0 28
  , .halt 0
  ]

private def structuralShapeFuel (bound : ℕ) : ℕ :=
  4 * (bound + 1) + 26

private def structuralShapeWorkBound
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  max
    (structuralPreparedCode outputs width count bound index)
    (structuralControllerContext outputs width count bound index)

private def structuralShapeBits
    (outputs : List ℕ) (width count bound index : ℕ) : ℕ :=
  natBitLength <|
    structuralShapeWorkBound outputs width count bound index

@[simp] private theorem structuralShapeProgram_oracleFree :
    OracleFree structuralShapeProgram := by
  rfl

private theorem structuralRowWidth_eq
    (width bound : ℕ) :
    structuralRowWidth width bound =
      6 + 2 * boundedCircuitFieldLimit width bound := by
  simp [structuralRowWidth, boundedCircuitFieldLimit]

private theorem structuralInputArity_eq
    (width bound : ℕ) :
    structuralInputArity width bound =
      (bound + 1) * structuralRowWidth width bound := by
  simp [structuralInputArity, descriptionWidth,
    boundedCircuitDescriptionWidth, structuralRowWidth,
    boundedCircuitFieldLimit]

set_option maxHeartbeats 800000 in
-- The recursive machine-state trace expands five nested public pair fields.
private theorem run_structuralShapeLoop
    (outputs : List ℕ) (width count bound index : ℕ)
    (remaining accumulator : ℕ) (state : NPOracleState)
    (hpc : state.pc = 17)
    (htable : state.registers 2 = encodeTaggedList outputs)
    (hindex : state.registers 4 = index)
    (hshape :
      state.registers 5 = structuralShapeCode width count bound)
    (hone : state.registers 10 = 1)
    (hrowWidth :
      state.registers 13 = structuralRowWidth width bound)
    (hremaining : state.registers 15 = remaining)
    (haccumulator : state.registers 16 = accumulator)
    (hinvariant :
      accumulator + remaining * structuralRowWidth width bound =
        structuralInputArity width bound) :
    runNPOracleProgram structuralShapeProgram
        (structuralShapeBits outputs width count bound index)
        (4 * remaining + 9) state =
      some
        (structuralControllerContext
          outputs width count bound index) := by
  let inputArity := structuralInputArity width bound
  let target := index - inputArity
  let inputGap := inputArity - index
  let metadata := structuralMetadataCode width count bound index
  let tagged := encodeTaggedList outputs
  let output :=
    structuralControllerContext outputs width count bound index
  let workBound :=
    structuralShapeWorkBound outputs width count bound index
  let maximumBits :=
    structuralShapeBits outputs width count bound index
  have hbitsOf : ∀ {value : ℕ}, value ≤ workBound →
      natBitLength value ≤ maximumBits := by
    intro value hvalue
    exact natBitLength_mono hvalue
  have hprepared :
      structuralPreparedCode outputs width count bound index ≤
        workBound := Nat.le_max_left _ _
  have houtput : output ≤ workBound := Nat.le_max_right _ _
  have htagged : tagged ≤ workBound := by
    exact
      (Nat.left_le_pair tagged
        (structuralMetadataCode width count bound index)).trans
        hprepared
  have hmetadataPrepared : metadata ≤ workBound := by
    exact
      (Nat.right_le_pair tagged metadata).trans hprepared
  have houtputForm :
      output =
        Nat.pair tagged
          (Nat.pair inputGap
            (Nat.pair inputArity
              (Nat.pair target metadata))) := by
    rfl
  have hpacked :
      Nat.pair inputGap
          (Nat.pair inputArity (Nat.pair target metadata)) ≤
        workBound := by
    exact
      (Nat.right_le_pair tagged
        (Nat.pair inputGap
          (Nat.pair inputArity (Nat.pair target metadata)))).trans <|
        houtputForm ▸ houtput
  have hinputGap :
      inputGap ≤ workBound :=
    (Nat.left_le_pair inputGap
      (Nat.pair inputArity (Nat.pair target metadata))).trans hpacked
  have harityAndTail :
      Nat.pair inputArity (Nat.pair target metadata) ≤ workBound :=
    (Nat.right_le_pair inputGap
      (Nat.pair inputArity (Nat.pair target metadata))).trans hpacked
  have hinputArity : inputArity ≤ workBound :=
    (Nat.left_le_pair inputArity
      (Nat.pair target metadata)).trans harityAndTail
  have htargetAndMetadata :
      Nat.pair target metadata ≤ workBound :=
    (Nat.right_le_pair inputArity
      (Nat.pair target metadata)).trans harityAndTail
  have htarget : target ≤ workBound :=
    (Nat.left_le_pair target metadata).trans htargetAndMetadata
  have hmetadata : metadata ≤ workBound :=
    (Nat.right_le_pair target metadata).trans htargetAndMetadata
  have hindexAndShape :
      Nat.pair index (structuralShapeCode width count bound) ≤
        workBound := by
    simpa only [metadata, structuralMetadataCode] using hmetadata
  have hindexBound : index ≤ workBound :=
    (Nat.left_le_pair index
      (structuralShapeCode width count bound)).trans hindexAndShape
  have hshapeBound :
      structuralShapeCode width count bound ≤ workBound :=
    (Nat.right_le_pair index
      (structuralShapeCode width count bound)).trans hindexAndShape
  have hrowWidthLeArity :
      structuralRowWidth width bound ≤ inputArity := by
    dsimp only [inputArity]
    rw [structuralInputArity_eq]
    nlinarith
  have hrowWidthBound :
      structuralRowWidth width bound ≤ workBound :=
    hrowWidthLeArity.trans hinputArity
  have haccumulatorLe : accumulator ≤ inputArity := by
    omega
  have haccumulatorBound : accumulator ≤ workBound :=
    haccumulatorLe.trans hinputArity
  cases remaining with
  | zero =>
      have haccumulatorEq : accumulator = inputArity := by
        simpa using hinvariant
      rw [show 4 * 0 + 9 = 8 + 1 by omega]
      rw [run_branchZero_instruction (by rfl) hpc]
      rw [if_pos (by simpa using hremaining)]
      rw [show 8 = 7 + 1 by omega]
      rw [run_subtract_instruction (value := target)
        (by rfl) rfl
        (by
          simp [hindex, haccumulator, haccumulatorEq,
            target, inputArity])
        (hbitsOf htarget)]
      rw [show 7 = 6 + 1 by omega]
      rw [run_subtract_instruction (value := inputGap)
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            hindex, haccumulator, haccumulatorEq,
            inputGap, inputArity])
        (hbitsOf hinputGap)]
      rw [show 6 = 5 + 1 by omega]
      rw [run_pair_instruction (value := metadata)
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            hindex, hshape, metadata,
            structuralMetadataCode])
        (hbitsOf hmetadata)]
      rw [show 5 = 4 + 1 by omega]
      rw [run_pair_instruction
        (value := Nat.pair target metadata)
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            target, metadata])
        (hbitsOf htargetAndMetadata)]
      rw [show 4 = 3 + 1 by omega]
      rw [run_pair_instruction
        (value := Nat.pair inputArity (Nat.pair target metadata))
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            haccumulator, haccumulatorEq,
            inputArity, target, metadata])
        (hbitsOf harityAndTail)]
      rw [show 3 = 2 + 1 by omega]
      rw [run_pair_instruction
        (value :=
          Nat.pair inputGap <|
            Nat.pair inputArity (Nat.pair target metadata))
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            inputGap, inputArity, target, metadata])
        (hbitsOf hpacked)]
      rw [show 2 = 1 + 1 by omega]
      rw [run_pair_instruction (value := output)
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            htable, output, structuralControllerContext,
            inputGap, inputArity, target, metadata])
        (hbitsOf houtput)]
      exact run_halt_instruction (fuel := 0)
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            output])
        (hbitsOf houtput)
  | succ remaining =>
      let nextAccumulator :=
        accumulator + structuralRowWidth width bound
      have hnextInvariant :
          nextAccumulator +
              remaining * structuralRowWidth width bound =
            inputArity := by
        dsimp only [nextAccumulator, inputArity] at *
        simpa [Nat.add_mul, Nat.add_assoc, Nat.add_left_comm,
          Nat.add_comm] using hinvariant
      have hnextAccumulatorLe : nextAccumulator ≤ inputArity := by
        omega
      have hnextAccumulatorBound :
          nextAccumulator ≤ workBound :=
        hnextAccumulatorLe.trans hinputArity
      rw [show
        4 * (remaining + 1) + 9 =
          (4 * remaining + 12) + 1 by omega]
      rw [run_branchZero_instruction (by rfl) hpc]
      rw [if_neg (by
        rw [hremaining]
        omega)]
      rw [show
        4 * remaining + 12 =
          (4 * remaining + 11) + 1 by omega]
      rw [run_add_instruction (value := nextAccumulator)
        (by rfl) rfl
        (by
          simp [haccumulator, hrowWidth, nextAccumulator])
        (hbitsOf hnextAccumulatorBound)]
      rw [show
        4 * remaining + 11 =
          (4 * remaining + 10) + 1 by omega]
      rw [run_decrement_instruction (value := remaining)
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            hremaining])
        (hbitsOf <| by
          have hrowPositive :
              0 < structuralRowWidth width bound := by
            simp [structuralRowWidth]
          have hremainingLeProduct :
              remaining ≤
                (remaining + 1) *
                  structuralRowWidth width bound := by
            exact (Nat.le_succ remaining).trans
              (Nat.le_mul_of_pos_right _ hrowPositive)
          have hproductLeArity :
              (remaining + 1) *
                  structuralRowWidth width bound ≤
                inputArity := by
            omega
          exact
            (hremainingLeProduct.trans hproductLeArity).trans
              hinputArity)]
      rw [show
        4 * remaining + 10 =
          (4 * remaining + 9) + 1 by omega]
      rw [run_branchZero_instruction (by rfl) rfl]
      rw [if_neg (by
        simp [NPOracleState.write, NPOracleState.jump, hone])]
      apply run_structuralShapeLoop
        outputs width count bound index
        remaining nextAccumulator
      · rfl
      · simp [NPOracleState.write, NPOracleState.jump, htable]
      · simp [NPOracleState.write, NPOracleState.jump, hindex]
      · simp [NPOracleState.write, NPOracleState.jump, hshape]
      · simp [NPOracleState.write, NPOracleState.jump, hone]
      · simp [NPOracleState.write, NPOracleState.jump, hrowWidth]
      · simp [NPOracleState.write, NPOracleState.jump]
      · simp [NPOracleState.write, NPOracleState.jump,
          nextAccumulator]
      · exact hnextInvariant

set_option maxHeartbeats 800000 in
-- The fixed 17-instruction parser feeds the separately proved arithmetic loop.
private theorem run_structuralShapeProgram
    (inputLength : ℕ) (outputs : List ℕ)
    (width count bound index : ℕ) :
    runNPOracleProgram structuralShapeProgram
        (structuralShapeBits outputs width count bound index)
        (structuralShapeFuel bound)
        (initialNPOracleState inputLength
          (structuralPreparedCode
            outputs width count bound index)) =
      some
        (structuralControllerContext
          outputs width count bound index) := by
  let tagged := encodeTaggedList outputs
  let countAndBound := Nat.pair count bound
  let shape := structuralShapeCode width count bound
  let metadata := structuralMetadataCode width count bound index
  let prepared :=
    structuralPreparedCode outputs width count bound index
  let inputArity := structuralInputArity width bound
  let fieldBase := width + bound
  let fieldLimit := fieldBase + 1
  let doubled := 2 * fieldLimit
  let rowWidth := structuralRowWidth width bound
  let rows := bound + 1
  let output :=
    structuralControllerContext outputs width count bound index
  let workBound :=
    structuralShapeWorkBound outputs width count bound index
  let maximumBits :=
    structuralShapeBits outputs width count bound index
  have hbitsOf : ∀ {value : ℕ}, value ≤ workBound →
      natBitLength value ≤ maximumBits := by
    intro value hvalue
    exact natBitLength_mono hvalue
  have hprepared : prepared ≤ workBound := Nat.le_max_left _ _
  have houtput : output ≤ workBound := Nat.le_max_right _ _
  have htagged : tagged ≤ workBound := by
    exact (Nat.left_le_pair tagged metadata).trans hprepared
  have hmetadata : metadata ≤ workBound := by
    exact (Nat.right_le_pair tagged metadata).trans hprepared
  have hindexAndShape :
      Nat.pair index shape ≤ workBound := by
    simpa only [metadata, structuralMetadataCode] using hmetadata
  have hindex : index ≤ workBound :=
    (Nat.left_le_pair index shape).trans hindexAndShape
  have hshape : shape ≤ workBound :=
    (Nat.right_le_pair index shape).trans hindexAndShape
  have hwidthAndCountBound :
      Nat.pair width countAndBound ≤ workBound := by
    simpa only [shape, structuralShapeCode] using hshape
  have hwidth : width ≤ workBound :=
    (Nat.left_le_pair width countAndBound).trans
      hwidthAndCountBound
  have hcountAndBound : countAndBound ≤ workBound :=
    (Nat.right_le_pair width countAndBound).trans
      hwidthAndCountBound
  have hcount : count ≤ workBound :=
    (Nat.left_le_pair count bound).trans hcountAndBound
  have hbound : bound ≤ workBound :=
    (Nat.right_le_pair count bound).trans hcountAndBound
  have houtputForm :
      output =
        Nat.pair tagged
          (Nat.pair (inputArity - index)
            (Nat.pair inputArity
              (Nat.pair (index - inputArity) metadata))) := by
    rfl
  have houtputTail :
      Nat.pair (inputArity - index)
          (Nat.pair inputArity
            (Nat.pair (index - inputArity) metadata)) ≤
        workBound := by
    exact
      (Nat.right_le_pair tagged
        (Nat.pair (inputArity - index)
          (Nat.pair inputArity
            (Nat.pair (index - inputArity) metadata)))).trans <|
        houtputForm ▸ houtput
  have harityTail :
      Nat.pair inputArity
          (Nat.pair (index - inputArity) metadata) ≤
        workBound :=
    (Nat.right_le_pair (inputArity - index)
      (Nat.pair inputArity
        (Nat.pair (index - inputArity) metadata))).trans houtputTail
  have harity : inputArity ≤ workBound :=
    (Nat.left_le_pair inputArity
      (Nat.pair (index - inputArity) metadata)).trans harityTail
  have hrowWidthLeArity : rowWidth ≤ inputArity := by
    dsimp only [rowWidth, inputArity]
    rw [structuralInputArity_eq]
    nlinarith
  have hrowWidth : rowWidth ≤ workBound :=
    hrowWidthLeArity.trans harity
  have hrowWidthPositive : 0 < rowWidth := by
    simp [rowWidth, structuralRowWidth]
  have hrowsLeArity : rows ≤ inputArity := by
    rw [show inputArity = rows * rowWidth by
      simp [inputArity, rows, rowWidth,
        structuralInputArity_eq]]
    exact Nat.le_mul_of_pos_right rows hrowWidthPositive
  have hrows : rows ≤ workBound :=
    hrowsLeArity.trans harity
  have hfieldBaseLeRowWidth : fieldBase ≤ rowWidth := by
    dsimp only [fieldBase, rowWidth, structuralRowWidth]
    omega
  have hfieldLimitLeRowWidth : fieldLimit ≤ rowWidth := by
    dsimp only [fieldLimit, fieldBase, rowWidth,
      structuralRowWidth]
    omega
  have hdoubledEq :
      doubled = Nat.shiftLeft fieldLimit 1 := by
    simp [doubled, Nat.shiftLeft_eq, Nat.mul_comm]
  have hdoubledLeRowWidth : doubled ≤ rowWidth := by
    dsimp only [doubled, fieldLimit, fieldBase,
      rowWidth, structuralRowWidth]
    omega
  have hsixLeRowWidth : 6 ≤ rowWidth := by
    simp [rowWidth, structuralRowWidth]
  have hfieldBase : fieldBase ≤ workBound :=
    hfieldBaseLeRowWidth.trans hrowWidth
  have hfieldLimit : fieldLimit ≤ workBound :=
    hfieldLimitLeRowWidth.trans hrowWidth
  have hdoubled : doubled ≤ workBound :=
    hdoubledLeRowWidth.trans hrowWidth
  have hsix : 6 ≤ workBound :=
    hsixLeRowWidth.trans hrowWidth
  have hone : 1 ≤ workBound :=
    (by omega : 1 ≤ rowWidth).trans hrowWidth
  have hzero : 0 ≤ workBound := Nat.zero_le _
  rw [show
    structuralShapeFuel bound =
      (4 * rows + 9) + 17 by
    simp [structuralShapeFuel, rows]]
  rw [run_unpairLeft_instruction (value := tagged)
    (by rfl) rfl
    (by
      simp [initialNPOracleState,
        structuralPreparedCode, tagged])
    (hbitsOf htagged)]
  rw [show 4 * rows + 9 + 16 =
      (4 * rows + 9 + 15) + 1 by omega]
  rw [run_unpairRight_instruction (value := metadata)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump,
        structuralPreparedCode, metadata])
    (hbitsOf hmetadata)]
  rw [show 4 * rows + 9 + 15 =
      (4 * rows + 9 + 14) + 1 by omega]
  rw [run_unpairLeft_instruction (value := index)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, metadata,
        structuralMetadataCode])
    (hbitsOf hindex)]
  rw [show 4 * rows + 9 + 14 =
      (4 * rows + 9 + 13) + 1 by omega]
  rw [run_unpairRight_instruction (value := shape)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, metadata, shape,
        structuralMetadataCode])
    (hbitsOf hshape)]
  rw [show 4 * rows + 9 + 13 =
      (4 * rows + 9 + 12) + 1 by omega]
  rw [run_unpairLeft_instruction (value := width)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, shape, structuralShapeCode])
    (hbitsOf hwidth)]
  rw [show 4 * rows + 9 + 12 =
      (4 * rows + 9 + 11) + 1 by omega]
  rw [run_unpairRight_instruction (value := countAndBound)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, shape, structuralShapeCode,
        countAndBound])
    (hbitsOf hcountAndBound)]
  rw [show 4 * rows + 9 + 11 =
      (4 * rows + 9 + 10) + 1 by omega]
  rw [run_unpairLeft_instruction (value := count)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, countAndBound])
    (hbitsOf hcount)]
  rw [show 4 * rows + 9 + 10 =
      (4 * rows + 9 + 9) + 1 by omega]
  rw [run_unpairRight_instruction (value := bound)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, countAndBound])
    (hbitsOf hbound)]
  rw [show 4 * rows + 9 + 9 =
      (4 * rows + 9 + 8) + 1 by omega]
  rw [run_set_instruction (value := 1)
    (by rfl) rfl (hbitsOf hone)]
  rw [show 4 * rows + 9 + 8 =
      (4 * rows + 9 + 7) + 1 by omega]
  rw [run_add_instruction (value := fieldBase)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, fieldBase])
    (hbitsOf hfieldBase)]
  rw [show 4 * rows + 9 + 7 =
      (4 * rows + 9 + 6) + 1 by omega]
  rw [run_increment_instruction (value := fieldLimit)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, fieldBase, fieldLimit])
    (hbitsOf hfieldLimit)]
  rw [show 4 * rows + 9 + 6 =
      (4 * rows + 9 + 5) + 1 by omega]
  rw [run_shiftLeft_instruction (value := doubled)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, fieldLimit, hdoubledEq])
    (hbitsOf hdoubled)]
  rw [show 4 * rows + 9 + 5 =
      (4 * rows + 9 + 4) + 1 by omega]
  rw [run_set_instruction (value := 6)
    (by rfl) rfl (hbitsOf hsix)]
  rw [show 4 * rows + 9 + 4 =
      (4 * rows + 9 + 3) + 1 by omega]
  rw [run_add_instruction (value := rowWidth)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, doubled, rowWidth,
        structuralRowWidth, fieldLimit, fieldBase,
        Nat.add_comm])
    (hbitsOf hrowWidth)]
  rw [show 4 * rows + 9 + 3 =
      (4 * rows + 9 + 2) + 1 by omega]
  rw [run_copy_instruction (value := bound)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
    (hbitsOf hbound)]
  rw [show 4 * rows + 9 + 2 =
      (4 * rows + 9 + 1) + 1 by omega]
  rw [run_increment_instruction (value := rows)
    (by rfl) rfl
    (by
      simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump, rows])
    (hbitsOf hrows)]
  rw [show 4 * rows + 9 + 1 =
      (4 * rows + 9) + 1 by omega]
  rw [run_set_instruction (value := 0)
    (by rfl) rfl (hbitsOf hzero)]
  apply run_structuralShapeLoop
    outputs width count bound index rows 0
  · rfl
  · simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump, tagged]
  · simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump]
  · simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump, shape]
  · simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump]
  · simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump, rowWidth]
  · simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump, rows]
  · simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump]
  · simpa only [Nat.zero_add] using
      (structuralInputArity_eq width bound).symm

/-! ## Single public-to-controller prelude -/

private def structuralPreludeProgram : NPOracleProgram :=
  linkPrograms structuralPreparationProgram structuralShapeProgram

private def structuralPreludeFuel
    (outputs : List ℕ) (bound : ℕ) : ℕ :=
  linkFuel structuralShapeProgram
    (structuralPreparationFuel outputs)
    (structuralShapeFuel bound)

private def structuralPreludeBits
    (inputLength : ℕ) (outputs : List ℕ)
    (width count bound index : ℕ) : ℕ :=
  max (natBitLength inputLength) <|
    max
      (structuralPreparationBits
        inputLength outputs width count bound index)
      (structuralShapeBits outputs width count bound index)

@[simp] private theorem structuralPreludeProgram_oracleFree :
    OracleFree structuralPreludeProgram := by
  exact oracleFree_linkPrograms
    structuralPreparationProgram_oracleFree
    structuralShapeProgram_oracleFree

private theorem run_structuralPreludeProgram
    (inputLength : ℕ) (outputs : List ℕ)
    (width count bound index : ℕ) :
    runNPOracleProgram structuralPreludeProgram
        (structuralPreludeBits
          inputLength outputs width count bound index)
        (structuralPreludeFuel outputs bound)
        (initialNPOracleState inputLength
          (structuralFormulaRequestCode
            outputs width count bound index)) =
      some
        (structuralControllerContext
          outputs width count bound index) := by
  let preparationBits :=
    structuralPreparationBits
      inputLength outputs width count bound index
  let shapeBits :=
    structuralShapeBits outputs width count bound index
  let maximumBits :=
    structuralPreludeBits
      inputLength outputs width count bound index
  have hlengthBits : natBitLength inputLength ≤ maximumBits :=
    Nat.le_max_left _ _
  have hpreparationBits : preparationBits ≤ maximumBits := by
    exact (Nat.le_max_left _ _).trans (Nat.le_max_right _ _)
  have hshapeBits : shapeBits ≤ maximumBits := by
    exact (Nat.le_max_right _ _).trans (Nat.le_max_right _ _)
  have hpositive : 1 ≤ maximumBits := by
    exact (by
      unfold natBitLength
      omega : 1 ≤ natBitLength inputLength).trans hlengthBits
  have hpreparation :
      runNPOracleProgram structuralPreparationProgram maximumBits
          (structuralPreparationFuel outputs)
          (initialNPOracleState inputLength
            (structuralFormulaRequestCode
              outputs width count bound index)) =
        some
          (structuralPreparedCode
            outputs width count bound index) :=
    run_bits_mono
      (run_structuralPreparationProgram inputLength outputs
        width count bound index)
      hpreparationBits
  have hshape :
      runNPOracleProgram structuralShapeProgram maximumBits
          (structuralShapeFuel bound)
          (initialNPOracleState inputLength
            (structuralPreparedCode
              outputs width count bound index)) =
        some
          (structuralControllerContext
            outputs width count bound index) :=
    run_bits_mono
      (run_structuralShapeProgram inputLength outputs
        width count bound index)
      hshapeBits
  exact run_linkPrograms hpositive hlengthBits
    hpreparation hshape

/-! ## Internal tagged-table lookup -/

private def structuralTaggedLookupInput (table index : ℕ) : ℕ :=
  Nat.pair table index

/-- Total lookup on the private `encodeTaggedList` spine.  Register five is
never written, so its initial zero supplies the sole unconditional back edge. -/
private def structuralTaggedLookupProgram : NPOracleProgram :=
  [ .unpairLeft 0 2 1
  , .unpairRight 0 3 2
  , .branchZero 3 7 3
  , .unpairRight 2 4 4
  , .unpairRight 4 2 5
  , .decrement 3 6
  , .branchZero 5 2 2
  , .unpairRight 2 4 8
  , .unpairLeft 4 0 9
  , .halt 0
  ]

private def structuralTaggedLookupFuel (index : ℕ) : ℕ :=
  5 * index + 6

private def structuralTaggedLookupBits
    (values : List ℕ) (index : ℕ) : ℕ :=
  natBitLength <|
    structuralTaggedLookupInput (encodeTaggedList values) index

@[simp] private theorem structuralTaggedLookupProgram_oracleFree :
    OracleFree structuralTaggedLookupProgram := by
  rfl

private theorem run_structuralTaggedLookupLoop
    (values : List ℕ) (index maximumBits : ℕ)
    (state : NPOracleState)
    (hpc : state.pc = 2)
    (htable : state.registers 2 = encodeTaggedList values)
    (hindex : state.registers 3 = index)
    (hzero : state.registers 5 = 0)
    (htableBits :
      natBitLength (encodeTaggedList values) ≤ maximumBits)
    (hindexBits : natBitLength index ≤ maximumBits) :
    runNPOracleProgram structuralTaggedLookupProgram maximumBits
        (5 * index + 4) state =
      some (values.getD index 0) := by
  induction index generalizing values state with
  | zero =>
      cases values with
      | nil =>
          rw [show 5 * 0 + 4 = 3 + 1 by omega]
          rw [run_branchZero_instruction (by rfl) hpc]
          rw [show state.registers 3 = 0 by simpa using hindex,
            if_pos rfl]
          rw [show 3 = 2 + 1 by omega]
          rw [run_unpairRight_instruction (value := 0)
            (by rfl) rfl
            (by simp [NPOracleState.jump, htable, encodeTaggedList])
            (by simpa [encodeTaggedList] using htableBits)]
          rw [show 2 = 1 + 1 by omega]
          rw [run_unpairLeft_instruction (value := 0)
            (by rfl) rfl
            (by simp [NPOracleState.write, NPOracleState.jump])
            (by simpa [encodeTaggedList] using htableBits)]
          exact run_halt_instruction (fuel := 0)
            (by rfl) rfl
            (by simp [NPOracleState.write, NPOracleState.jump])
            (by simpa [encodeTaggedList] using htableBits)
      | cons value rest =>
          let payload := Nat.pair value (encodeTaggedList rest)
          have hpayloadBits :
              natBitLength payload ≤ maximumBits := by
            exact
              (natBitLength_mono <|
                Nat.right_le_pair 1 payload).trans htableBits
          have hvalueBits :
              natBitLength value ≤ maximumBits := by
            exact
              (natBitLength_mono <|
                Nat.left_le_pair value (encodeTaggedList rest)).trans
                hpayloadBits
          rw [show 5 * 0 + 4 = 3 + 1 by omega]
          rw [run_branchZero_instruction (by rfl) hpc]
          rw [show state.registers 3 = 0 by simpa using hindex,
            if_pos rfl]
          rw [show 3 = 2 + 1 by omega]
          rw [run_unpairRight_instruction (value := payload)
            (by rfl) rfl
            (by
              simp [NPOracleState.jump, htable, encodeTaggedList,
                payload])
            hpayloadBits]
          rw [show 2 = 1 + 1 by omega]
          rw [run_unpairLeft_instruction (value := value)
            (by rfl) rfl
            (by
              simp [NPOracleState.write, NPOracleState.jump,
                payload])
            hvalueBits]
          exact run_halt_instruction (fuel := 0)
            (by rfl) rfl
            (by simp [NPOracleState.write, NPOracleState.jump])
            hvalueBits
  | succ index inductionHypothesis =>
      rw [show 5 * (index + 1) + 4 =
          (5 * index + 8) + 1 by omega]
      rw [run_branchZero_instruction (by rfl) hpc]
      rw [show state.registers 3 = index + 1 by simpa using hindex,
        if_neg (by omega)]
      cases values with
      | nil =>
          have hzeroBits : natBitLength 0 ≤ maximumBits := by
            simpa [encodeTaggedList] using htableBits
          rw [show 5 * index + 8 = (5 * index + 7) + 1 by omega]
          rw [run_unpairRight_instruction (value := 0)
            (by rfl) rfl
            (by simp [NPOracleState.jump, htable, encodeTaggedList])
            hzeroBits]
          rw [show 5 * index + 7 = (5 * index + 6) + 1 by omega]
          rw [run_unpairRight_instruction (value := 0)
            (by rfl) rfl
            (by simp [NPOracleState.write, NPOracleState.jump])
            hzeroBits]
          rw [show 5 * index + 6 = (5 * index + 5) + 1 by omega]
          rw [run_decrement_instruction (value := index)
            (by rfl) rfl
            (by simp [NPOracleState.write, NPOracleState.jump,
              hindex])
            (decrement_bits_le (index + 1) |>.trans hindexBits)]
          rw [show 5 * index + 5 = (5 * index + 4) + 1 by omega]
          rw [run_branchZero_instruction (by rfl) rfl]
          rw [show
              (((((state.jump 3).write 4 0).jump 4).write 2 0).jump 5
                |>.write 3 index |>.jump 6).registers 5 = 0 by
              simp [NPOracleState.write, NPOracleState.jump, hzero],
            if_pos rfl]
          exact inductionHypothesis [] _ rfl
            (by simp [NPOracleState.write, NPOracleState.jump,
              encodeTaggedList])
            (by simp [NPOracleState.write, NPOracleState.jump])
            (by simp [NPOracleState.write, NPOracleState.jump,
              hzero])
            hzeroBits
            (decrement_bits_le (index + 1) |>.trans hindexBits)
      | cons value rest =>
          let payload := Nat.pair value (encodeTaggedList rest)
          have hpayloadBits :
              natBitLength payload ≤ maximumBits := by
            exact
              (natBitLength_mono <|
                Nat.right_le_pair 1 payload).trans htableBits
          have htailBits :
              natBitLength (encodeTaggedList rest) ≤ maximumBits := by
            exact
              (natBitLength_mono <|
                Nat.right_le_pair value (encodeTaggedList rest)).trans
                hpayloadBits
          rw [show 5 * index + 8 = (5 * index + 7) + 1 by omega]
          rw [run_unpairRight_instruction (value := payload)
            (by rfl) rfl
            (by
              simp [NPOracleState.jump, htable, encodeTaggedList,
                payload])
            hpayloadBits]
          rw [show 5 * index + 7 = (5 * index + 6) + 1 by omega]
          rw [run_unpairRight_instruction
            (value := encodeTaggedList rest)
            (by rfl) rfl
            (by
              simp [NPOracleState.write, NPOracleState.jump,
                payload])
            htailBits]
          rw [show 5 * index + 6 = (5 * index + 5) + 1 by omega]
          rw [run_decrement_instruction (value := index)
            (by rfl) rfl
            (by simp [NPOracleState.write, NPOracleState.jump,
              hindex])
            (decrement_bits_le (index + 1) |>.trans hindexBits)]
          rw [show 5 * index + 5 = (5 * index + 4) + 1 by omega]
          rw [run_branchZero_instruction (by rfl) rfl]
          rw [show
              (((((state.jump 3).write 4 payload).jump 4).write 2
                  (encodeTaggedList rest)).jump 5
                |>.write 3 index |>.jump 6).registers 5 = 0 by
              simp [NPOracleState.write, NPOracleState.jump, hzero],
            if_pos rfl]
          exact inductionHypothesis rest _ rfl
            (by simp [NPOracleState.write, NPOracleState.jump])
            (by simp [NPOracleState.write, NPOracleState.jump])
            (by simp [NPOracleState.write, NPOracleState.jump,
              hzero])
            htailBits
            (decrement_bits_le (index + 1) |>.trans hindexBits)

private theorem run_structuralTaggedLookupProgram
    (inputLength : ℕ) (values : List ℕ) (index : ℕ) :
    runNPOracleProgram structuralTaggedLookupProgram
        (structuralTaggedLookupBits values index)
        (structuralTaggedLookupFuel index)
        (initialNPOracleState inputLength <|
          structuralTaggedLookupInput
            (encodeTaggedList values) index) =
      some (values.getD index 0) := by
  let input :=
    structuralTaggedLookupInput (encodeTaggedList values) index
  let maximumBits := structuralTaggedLookupBits values index
  have hinputBits : natBitLength input ≤ maximumBits := by
    rfl
  have htableBits :
      natBitLength (encodeTaggedList values) ≤ maximumBits := by
    exact
      (natBitLength_mono <|
        Nat.left_le_pair (encodeTaggedList values) index).trans
        hinputBits
  have hindexBits : natBitLength index ≤ maximumBits := by
    exact
      (natBitLength_mono <|
        Nat.right_le_pair (encodeTaggedList values) index).trans
        hinputBits
  rw [show structuralTaggedLookupFuel index =
      (5 * index + 4) + 2 by
    simp [structuralTaggedLookupFuel]]
  rw [show 5 * index + 4 + 2 =
      (5 * index + 5) + 1 by omega]
  rw [run_unpairLeft_instruction
    (value := encodeTaggedList values)
    (by rfl) rfl
    (by simp [initialNPOracleState,
      structuralTaggedLookupInput])
    htableBits]
  rw [show 5 * index + 5 = (5 * index + 4) + 1 by omega]
  rw [run_unpairRight_instruction (value := index)
    (by rfl) rfl
    (by simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump, structuralTaggedLookupInput])
    hindexBits]
  exact run_structuralTaggedLookupLoop values index maximumBits _
    rfl
    (by simp [NPOracleState.write, NPOracleState.jump])
    (by simp [NPOracleState.write, NPOracleState.jump])
    (by simp [initialNPOracleState, NPOracleState.write,
      NPOracleState.jump])
    htableBits hindexBits

/-! The scheduler retains live wires in reverse order so every append is one
private cons.  This fixed pass restores forward order only at consumers whose
canonical emission order depends on the original indices. -/

private def structuralTaggedReverseProgram : NPOracleProgram :=
  [ .set 2 0 1
  , .branchZero 0 9 2
  , .unpairRight 0 3 3
  , .unpairLeft 3 4 4
  , .unpairRight 3 0 5
  , .pair 4 2 5 6
  , .set 6 1 7
  , .pair 6 5 2 8
  , .branchZero 7 1 1
  , .copy 2 0 10
  , .halt 0
  ]

private def structuralTaggedReverseFuel (values : List ℕ) : ℕ :=
  8 * values.length + 4

private def structuralTaggedReverseBits (values : List ℕ) : ℕ :=
  natBitLength <|
    Nat.pair (encodeTaggedList values) (encodeTaggedList values.reverse)

private theorem encodeTaggedList_suffix_le
    (head suffix : List ℕ) :
    encodeTaggedList suffix ≤ encodeTaggedList (head ++ suffix) := by
  induction head with
  | nil => rfl
  | cons value rest inductionHypothesis =>
      simp only [List.cons_append, encodeTaggedList]
      exact inductionHypothesis.trans <|
        (Nat.right_le_pair value (encodeTaggedList (rest ++ suffix))).trans <|
          Nat.right_le_pair 1
            (Nat.pair value (encodeTaggedList (rest ++ suffix)))

private theorem run_structuralTaggedReverseLoop
    (remaining processed : List ℕ) (maximumBits : ℕ)
    (state : NPOracleState)
    (hpc : state.pc = 1)
    (hremaining : state.registers 0 = encodeTaggedList remaining)
    (hprocessed : state.registers 2 = encodeTaggedList processed)
    (hzero : state.registers 7 = 0)
    (hremainingBits :
      natBitLength (encodeTaggedList remaining) ≤ maximumBits)
    (hfinalBits :
      natBitLength
          (encodeTaggedList (remaining.reverse ++ processed)) ≤
        maximumBits) :
    runNPOracleProgram structuralTaggedReverseProgram maximumBits
        (8 * remaining.length + 3) state =
      some (encodeTaggedList (remaining.reverse ++ processed)) := by
  induction remaining generalizing processed state with
  | nil =>
      rw [show 8 * [].length + 3 = 2 + 1 by rfl]
      rw [run_branchZero_instruction (by rfl) hpc]
      rw [show state.registers 0 = 0 by
          simpa [encodeTaggedList] using hremaining,
        if_pos rfl]
      rw [run_copy_instruction
        (value := encodeTaggedList processed)
        (by rfl) rfl
        (by simpa [NPOracleState.jump] using hprocessed)
        (by simpa using hfinalBits)]
      exact run_halt_instruction (fuel := 0)
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump])
        (by simpa using hfinalBits)
  | cons value rest inductionHypothesis =>
      let payload := Nat.pair value (encodeTaggedList rest)
      let nextProcessed := value :: processed
      have hpayloadBits :
          natBitLength payload ≤ maximumBits := by
        exact
          (natBitLength_mono <|
            Nat.right_le_pair 1 payload).trans <| by
              simpa [payload, encodeTaggedList] using hremainingBits
      have hvalueBits :
          natBitLength value ≤ maximumBits := by
        exact
          (natBitLength_mono <|
            Nat.left_le_pair value (encodeTaggedList rest)).trans
            hpayloadBits
      have hrestBits :
          natBitLength (encodeTaggedList rest) ≤ maximumBits := by
        exact
          (natBitLength_mono <|
            Nat.right_le_pair value (encodeTaggedList rest)).trans
            hpayloadBits
      have hnextBits :
          natBitLength (encodeTaggedList nextProcessed) ≤ maximumBits := by
        apply (natBitLength_mono <|
          encodeTaggedList_suffix_le rest.reverse nextProcessed).trans
        simpa [nextProcessed] using hfinalBits
      have hinnerBits :
          natBitLength
              (Nat.pair value (encodeTaggedList processed)) ≤
            maximumBits := by
        exact
          (natBitLength_mono <|
            Nat.right_le_pair 1
              (Nat.pair value (encodeTaggedList processed))).trans <| by
                simpa [nextProcessed, encodeTaggedList] using hnextBits
      have honeBits : natBitLength 1 ≤ maximumBits := by
        exact
          (natBitLength_mono <|
            Nat.left_le_pair 1
              (Nat.pair value (encodeTaggedList processed))).trans <| by
                simpa [nextProcessed, encodeTaggedList] using hnextBits
      rw [show 8 * (value :: rest).length + 3 =
          (8 * rest.length + 10) + 1 by
        simp
        omega]
      rw [run_branchZero_instruction (by rfl) hpc]
      rw [show state.registers 0 =
          Nat.pair 1 payload by
            simpa [payload, encodeTaggedList] using hremaining,
        if_neg (by
          have hleft := Nat.left_le_pair 1 payload
          omega)]
      rw [show 8 * rest.length + 10 =
          (8 * rest.length + 9) + 1 by omega]
      rw [run_unpairRight_instruction (value := payload)
        (by rfl) rfl
        (by
          simp [NPOracleState.jump, hremaining,
            payload, encodeTaggedList])
        hpayloadBits]
      rw [show 8 * rest.length + 9 =
          (8 * rest.length + 8) + 1 by omega]
      rw [run_unpairLeft_instruction (value := value)
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump, payload])
        hvalueBits]
      rw [show 8 * rest.length + 8 =
          (8 * rest.length + 7) + 1 by omega]
      rw [run_unpairRight_instruction
        (value := encodeTaggedList rest)
        (by rfl) rfl
        (by simp [NPOracleState.write, NPOracleState.jump, payload])
        hrestBits]
      rw [show 8 * rest.length + 7 =
          (8 * rest.length + 6) + 1 by omega]
      rw [run_pair_instruction
        (value := Nat.pair value (encodeTaggedList processed))
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            hprocessed, payload])
        hinnerBits]
      rw [show 8 * rest.length + 6 =
          (8 * rest.length + 5) + 1 by omega]
      rw [run_set_instruction (value := 1)
        (by rfl) rfl honeBits]
      rw [show 8 * rest.length + 5 =
          (8 * rest.length + 4) + 1 by omega]
      rw [run_pair_instruction
        (value := encodeTaggedList nextProcessed)
        (by rfl) rfl
        (by
          simp [NPOracleState.write, NPOracleState.jump,
            nextProcessed, encodeTaggedList])
        hnextBits]
      rw [show 8 * rest.length + 4 =
          (8 * rest.length + 3) + 1 by omega]
      rw [run_branchZero_instruction (by rfl) rfl]
      rw [show
          (((((((state.jump 2).write 3 payload).jump 3
            |>.write 4 value |>.jump 4)
            |>.write 0 (encodeTaggedList rest) |>.jump 5)
            |>.write 5 (Nat.pair value (encodeTaggedList processed))
              |>.jump 6)
            |>.write 6 1 |>.jump 7)
            |>.write 2 (encodeTaggedList nextProcessed) |>.jump 8).registers
              7 = 0 by
            simp [NPOracleState.write, NPOracleState.jump, hzero],
        if_pos rfl]
      rw [show
          (value :: rest).reverse ++ processed =
            rest.reverse ++ nextProcessed by
        simp [nextProcessed]]
      apply inductionHypothesis nextProcessed
      · rfl
      · simp [NPOracleState.write, NPOracleState.jump]
      · simp [NPOracleState.write, NPOracleState.jump]
      · simp [NPOracleState.write, NPOracleState.jump, hzero]
      · exact hrestBits
      · simpa [nextProcessed] using hfinalBits

private theorem run_structuralTaggedReverseProgram
    (inputLength : ℕ) (values : List ℕ) :
    runNPOracleProgram structuralTaggedReverseProgram
        (structuralTaggedReverseBits values)
        (structuralTaggedReverseFuel values)
        (initialNPOracleState inputLength (encodeTaggedList values)) =
      some (encodeTaggedList values.reverse) := by
  have hinputBits :
      natBitLength (encodeTaggedList values) ≤
        structuralTaggedReverseBits values := by
    exact natBitLength_mono <|
      Nat.left_le_pair (encodeTaggedList values)
        (encodeTaggedList values.reverse)
  have houtputBits :
      natBitLength (encodeTaggedList values.reverse) ≤
        structuralTaggedReverseBits values := by
    exact natBitLength_mono <|
      Nat.right_le_pair (encodeTaggedList values)
        (encodeTaggedList values.reverse)
  rw [show structuralTaggedReverseFuel values =
      (8 * values.length + 3) + 1 by
    simp [structuralTaggedReverseFuel]]
  rw [run_set_instruction (value := 0)
    (by rfl) rfl
    (by
      unfold structuralTaggedReverseBits
      exact natBitLength_mono (Nat.zero_le _))]
  simpa using
    run_structuralTaggedReverseLoop values []
      (structuralTaggedReverseBits values)
      (((initialNPOracleState inputLength
        (encodeTaggedList values)).write 2 0).jump 1)
      rfl
      (by simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
      (by simp [NPOracleState.write, NPOracleState.jump, encodeTaggedList])
      (by simp [initialNPOracleState, NPOracleState.write,
        NPOracleState.jump])
      hinputBits
      (by simpa using houtputBits)

/-! ## Canonical selective-emission microkernel -/

def selectiveEmitStateCode
    (remaining next selectedCode : ℕ) : ℕ :=
  Nat.pair remaining (Nat.pair next selectedCode)

def selectiveEmitInput
    (remaining next selectedCode nodeCode : ℕ) : ℕ :=
  Nat.pair
    (selectiveEmitStateCode remaining next selectedCode)
    nodeCode

def selectiveEmitSelectedCode
    (remaining selectedCode nodeCode : ℕ) : ℕ :=
  if selectedCode = 0 ∧ remaining = 0 then
    Nat.pair 1 nodeCode
  else
    selectedCode

def selectiveEmitOutput
    (remaining next selectedCode nodeCode : ℕ) : ℕ :=
  Nat.pair
    (selectiveEmitStateCode remaining.pred (next + 1)
      (selectiveEmitSelectedCode
        remaining selectedCode nodeCode))
    next

/-- One append transition.  The selected node is written once when the target
countdown reaches zero; later emissions cannot overwrite it. -/
def selectiveEmitProgram : NPOracleProgram :=
  [ .unpairLeft 0 2 1
  , .unpairRight 0 3 2
  , .unpairLeft 2 4 3
  , .unpairRight 2 5 4
  , .unpairLeft 5 6 5
  , .unpairRight 5 7 6
  , .copy 6 8 7
  , .branchZero 7 8 12
  , .branchZero 4 9 12
  , .set 9 1 10
  , .pair 9 3 7 12
  , .branchZero 0 12 12
  , .decrement 4 13
  , .increment 6 14
  , .pair 6 7 10 15
  , .pair 4 10 11 16
  , .pair 11 8 0 17
  , .halt 0
  ]

def selectiveEmitFuel
    (remaining selectedCode : ℕ) : ℕ :=
  if selectedCode = 0 then
    if remaining = 0 then 17 else 15
  else
    14

def selectiveEmitWorkBound
    (remaining next selectedCode nodeCode : ℕ) : ℕ :=
  max
    (selectiveEmitInput remaining next selectedCode nodeCode)
    (selectiveEmitOutput remaining next selectedCode nodeCode)

def selectiveEmitBits
    (remaining next selectedCode nodeCode : ℕ) : ℕ :=
  natBitLength <|
    selectiveEmitWorkBound remaining next selectedCode nodeCode

@[simp] theorem selectiveEmitProgram_oracleFree :
    OracleFree selectiveEmitProgram := by
  rfl

theorem run_selectiveEmitFinish
    (remaining next selectedCode nodeCode : ℕ)
    (state : NPOracleState)
    (hpc : state.pc = 13)
    (hremaining : state.registers 4 = remaining.pred)
    (hnext : state.registers 6 = next)
    (hselected :
      state.registers 7 =
        selectiveEmitSelectedCode remaining selectedCode nodeCode)
    (houtputWire : state.registers 8 = next)
    (hnextIncBits :
      natBitLength (next + 1) ≤
        selectiveEmitBits remaining next selectedCode nodeCode)
    (hnextAndSelectedBits :
      natBitLength
          (Nat.pair (next + 1)
            (selectiveEmitSelectedCode
              remaining selectedCode nodeCode)) ≤
        selectiveEmitBits remaining next selectedCode nodeCode)
    (hstateBits :
      natBitLength
          (selectiveEmitStateCode remaining.pred (next + 1)
            (selectiveEmitSelectedCode
              remaining selectedCode nodeCode)) ≤
        selectiveEmitBits remaining next selectedCode nodeCode)
    (houtputBits :
      natBitLength
          (selectiveEmitOutput
            remaining next selectedCode nodeCode) ≤
        selectiveEmitBits remaining next selectedCode nodeCode) :
    runNPOracleProgram selectiveEmitProgram
        (selectiveEmitBits remaining next selectedCode nodeCode)
        5 state =
      some
        (selectiveEmitOutput
          remaining next selectedCode nodeCode) := by
  let newSelected :=
    selectiveEmitSelectedCode remaining selectedCode nodeCode
  let newState :=
    selectiveEmitStateCode remaining.pred (next + 1) newSelected
  let output :=
    selectiveEmitOutput remaining next selectedCode nodeCode
  rw [show 5 = 4 + 1 by omega]
  rw [run_increment_instruction (value := next + 1)
    (by rfl) hpc
    (by simp [hnext])
    hnextIncBits]
  rw [show 4 = 3 + 1 by omega]
  rw [run_pair_instruction
    (value := Nat.pair (next + 1) newSelected)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        hselected, newSelected])
    (by simpa only [newSelected] using hnextAndSelectedBits)]
  rw [show 3 = 2 + 1 by omega]
  rw [run_pair_instruction (value := newState)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        hremaining, newState, selectiveEmitStateCode])
    (by simpa only [newState, newSelected] using hstateBits)]
  rw [show 2 = 1 + 1 by omega]
  rw [run_pair_instruction (value := output)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        houtputWire, output, selectiveEmitOutput,
        newState, newSelected])
    (by simpa only [output] using houtputBits)]
  exact run_halt_instruction (fuel := 0)
    (by rfl) rfl
    (by
      simp [NPOracleState.write, NPOracleState.jump,
        output])
    (by simpa only [output] using houtputBits)

set_option maxHeartbeats 600000 in
-- Three short control branches share the same nested-pair write envelope.
theorem run_selectiveEmitProgram
    (remaining next selectedCode nodeCode : ℕ)
    (entry : NPOracleState) (hentryPc : entry.pc = 0)
    (hentryInput :
      entry.registers 0 =
        selectiveEmitInput remaining next selectedCode nodeCode) :
    runNPOracleProgram selectiveEmitProgram
        (selectiveEmitBits remaining next selectedCode nodeCode)
        (selectiveEmitFuel remaining selectedCode)
        entry =
      some
        (selectiveEmitOutput
          remaining next selectedCode nodeCode) := by
  let stateCode :=
    selectiveEmitStateCode remaining next selectedCode
  let input :=
    selectiveEmitInput remaining next selectedCode nodeCode
  let newSelected :=
    selectiveEmitSelectedCode remaining selectedCode nodeCode
  let newState :=
    selectiveEmitStateCode remaining.pred (next + 1) newSelected
  let output :=
    selectiveEmitOutput remaining next selectedCode nodeCode
  let workBound :=
    selectiveEmitWorkBound remaining next selectedCode nodeCode
  let maximumBits :=
    selectiveEmitBits remaining next selectedCode nodeCode
  have hbitsOf : ∀ {value : ℕ}, value ≤ workBound →
      natBitLength value ≤ maximumBits := by
    intro value hvalue
    exact natBitLength_mono hvalue
  have hinput : input ≤ workBound := Nat.le_max_left _ _
  have houtput : output ≤ workBound := Nat.le_max_right _ _
  have hstateCode : stateCode ≤ workBound := by
    exact (Nat.left_le_pair stateCode nodeCode).trans hinput
  have hnodeCode : nodeCode ≤ workBound := by
    exact (Nat.right_le_pair stateCode nodeCode).trans hinput
  have hremainingAndTail :
      Nat.pair remaining (Nat.pair next selectedCode) ≤ workBound := by
    simpa only [stateCode, selectiveEmitStateCode] using hstateCode
  have hremaining : remaining ≤ workBound :=
    (Nat.left_le_pair remaining
      (Nat.pair next selectedCode)).trans hremainingAndTail
  have hnextAndSelected :
      Nat.pair next selectedCode ≤ workBound :=
    (Nat.right_le_pair remaining
      (Nat.pair next selectedCode)).trans hremainingAndTail
  have hnext : next ≤ workBound :=
    (Nat.left_le_pair next selectedCode).trans hnextAndSelected
  have hselectedCode : selectedCode ≤ workBound :=
    (Nat.right_le_pair next selectedCode).trans hnextAndSelected
  have hnewState : newState ≤ workBound := by
    exact (Nat.left_le_pair newState next).trans houtput
  have hnewRemainingAndTail :
      Nat.pair remaining.pred (Nat.pair (next + 1) newSelected) ≤
        workBound := by
    simpa only [newState, selectiveEmitStateCode] using hnewState
  have hnewRemaining : remaining.pred ≤ workBound :=
    (Nat.left_le_pair remaining.pred
      (Nat.pair (next + 1) newSelected)).trans
      hnewRemainingAndTail
  have hnextIncAndSelected :
      Nat.pair (next + 1) newSelected ≤ workBound :=
    (Nat.right_le_pair remaining.pred
      (Nat.pair (next + 1) newSelected)).trans
      hnewRemainingAndTail
  have hnextInc : next + 1 ≤ workBound :=
    (Nat.left_le_pair (next + 1) newSelected).trans
      hnextIncAndSelected
  have hnewSelected : newSelected ≤ workBound :=
    (Nat.right_le_pair (next + 1) newSelected).trans
      hnextIncAndSelected
  have hone : 1 ≤ workBound := by
    by_cases hcapture : selectedCode = 0 ∧ remaining = 0
    · have hselectedPair :
          Nat.pair 1 nodeCode = newSelected := by
        simp [newSelected, selectiveEmitSelectedCode, hcapture]
      exact
        (Nat.left_le_pair 1 nodeCode).trans <|
          hselectedPair ▸ hnewSelected
    · have hnextPositive : 1 ≤ next + 1 := by omega
      exact hnextPositive.trans hnextInc
  have hfuelLower :
      14 ≤ selectiveEmitFuel remaining selectedCode := by
    by_cases hselectedZero : selectedCode = 0
    · by_cases hremainingZero : remaining = 0
      · simp [selectiveEmitFuel, hselectedZero,
          hremainingZero]
      · simp [selectiveEmitFuel, hselectedZero,
          hremainingZero]
    · simp [selectiveEmitFuel, hselectedZero]
  rw [show
    selectiveEmitFuel remaining selectedCode =
      (selectiveEmitFuel remaining selectedCode - 1) + 1 by
    omega]
  rw [run_unpairLeft_instruction (value := stateCode)
    (by rfl) hentryPc
    (by
      simp [hentryInput, selectiveEmitInput, stateCode])
    (hbitsOf hstateCode)]
  rw [show
    selectiveEmitFuel remaining selectedCode - 1 =
      (selectiveEmitFuel remaining selectedCode - 2) + 1 by
    omega]
  rw [run_unpairRight_instruction (value := nodeCode)
    (by rfl) rfl
    (by
      simp [hentryInput, NPOracleState.write,
        NPOracleState.jump, selectiveEmitInput,
        stateCode])
    (hbitsOf hnodeCode)]
  rw [show
    selectiveEmitFuel remaining selectedCode - 2 =
      (selectiveEmitFuel remaining selectedCode - 3) + 1 by
    omega]
  rw [run_unpairLeft_instruction (value := remaining)
    (by rfl) rfl
    (by
      simp [NPOracleState.write,
        NPOracleState.jump, stateCode,
        selectiveEmitStateCode])
    (hbitsOf hremaining)]
  rw [show
    selectiveEmitFuel remaining selectedCode - 3 =
      (selectiveEmitFuel remaining selectedCode - 4) + 1 by
    omega]
  rw [run_unpairRight_instruction
    (value := Nat.pair next selectedCode)
    (by rfl) rfl
    (by
      simp [NPOracleState.write,
        NPOracleState.jump, stateCode,
        selectiveEmitStateCode])
    (hbitsOf hnextAndSelected)]
  rw [show
    selectiveEmitFuel remaining selectedCode - 4 =
      (selectiveEmitFuel remaining selectedCode - 5) + 1 by
    omega]
  rw [run_unpairLeft_instruction (value := next)
    (by rfl) rfl
    (by
      simp [NPOracleState.write,
        NPOracleState.jump])
    (hbitsOf hnext)]
  rw [show
    selectiveEmitFuel remaining selectedCode - 5 =
      (selectiveEmitFuel remaining selectedCode - 6) + 1 by
    omega]
  rw [run_unpairRight_instruction (value := selectedCode)
    (by rfl) rfl
    (by
      simp [NPOracleState.write,
        NPOracleState.jump])
    (hbitsOf hselectedCode)]
  rw [show
    selectiveEmitFuel remaining selectedCode - 6 =
      (selectiveEmitFuel remaining selectedCode - 7) + 1 by
    omega]
  rw [run_copy_instruction (value := next)
    (by rfl) rfl
    (by
      simp [NPOracleState.write,
        NPOracleState.jump])
    (hbitsOf hnext)]
  rw [show
    selectiveEmitFuel remaining selectedCode - 7 =
      (selectiveEmitFuel remaining selectedCode - 8) + 1 by
    omega]
  rw [run_branchZero_instruction (by rfl) rfl]
  by_cases hselectedZero : selectedCode = 0
  · rw [if_pos (by
      simp [NPOracleState.write,
        NPOracleState.jump, hselectedZero])]
    rw [show
      selectiveEmitFuel remaining selectedCode - 8 =
        (selectiveEmitFuel remaining selectedCode - 9) + 1 by
      simp [selectiveEmitFuel, hselectedZero]
      split <;> omega]
    rw [run_branchZero_instruction (by rfl) rfl]
    by_cases hremainingZero : remaining = 0
    · rw [if_pos (by
        simp [NPOracleState.write,
          NPOracleState.jump, hremainingZero])]
      have hnewSelectedEq :
          newSelected = Nat.pair 1 nodeCode := by
        simp [newSelected, selectiveEmitSelectedCode,
          hselectedZero, hremainingZero]
      rw [show
        selectiveEmitFuel remaining selectedCode - 9 =
          7 + 1 by
        simp [selectiveEmitFuel, hselectedZero,
          hremainingZero]]
      rw [run_set_instruction (value := 1)
        (by rfl) rfl (hbitsOf hone)]
      rw [show 7 = 6 + 1 by omega]
      rw [run_pair_instruction (value := newSelected)
        (by rfl) rfl
        (by
          simp [NPOracleState.write,
            NPOracleState.jump, hnewSelectedEq])
        (hbitsOf hnewSelected)]
      rw [show 6 = 5 + 1 by omega]
      rw [run_decrement_instruction (value := remaining.pred)
        (by rfl) rfl
        (by
          simp [NPOracleState.write,
            NPOracleState.jump, hremainingZero])
        (hbitsOf hnewRemaining)]
      apply run_selectiveEmitFinish
        remaining next selectedCode nodeCode
      · rfl
      · simp [NPOracleState.write,
          NPOracleState.jump]
      · simp [NPOracleState.write,
          NPOracleState.jump]
      · simp [NPOracleState.write,
          NPOracleState.jump, hnewSelectedEq, newSelected]
      · simp [NPOracleState.write,
          NPOracleState.jump]
      · exact hbitsOf hnextInc
      · exact hbitsOf hnextIncAndSelected
      · exact hbitsOf hnewState
      · exact hbitsOf houtput
    · rw [if_neg (by
        simp [NPOracleState.write,
          NPOracleState.jump, hremainingZero])]
      have hnewSelectedEq : newSelected = selectedCode := by
        simp [newSelected, selectiveEmitSelectedCode,
          hselectedZero, hremainingZero]
      rw [show
        selectiveEmitFuel remaining selectedCode - 9 =
          5 + 1 by
        simp [selectiveEmitFuel, hselectedZero,
          hremainingZero]]
      rw [run_decrement_instruction (value := remaining.pred)
        (by rfl) rfl
        (by
          simp [NPOracleState.write,
            NPOracleState.jump])
        (hbitsOf hnewRemaining)]
      apply run_selectiveEmitFinish
        remaining next selectedCode nodeCode
      · rfl
      · simp [NPOracleState.write,
          NPOracleState.jump]
      · simp [NPOracleState.write,
          NPOracleState.jump]
      · simp [NPOracleState.write,
          NPOracleState.jump, hnewSelectedEq, newSelected]
      · simp [NPOracleState.write,
          NPOracleState.jump]
      · exact hbitsOf hnextInc
      · exact hbitsOf hnextIncAndSelected
      · exact hbitsOf hnewState
      · exact hbitsOf houtput
  · rw [if_neg (by
      simp [NPOracleState.write,
        NPOracleState.jump, hselectedZero])]
    have hnewSelectedEq : newSelected = selectedCode := by
      simp [newSelected, selectiveEmitSelectedCode,
        hselectedZero]
    rw [show
      selectiveEmitFuel remaining selectedCode - 8 =
        5 + 1 by
      simp [selectiveEmitFuel, hselectedZero]]
    rw [run_decrement_instruction (value := remaining.pred)
      (by rfl) rfl
      (by
        simp [NPOracleState.write,
          NPOracleState.jump])
      (hbitsOf hnewRemaining)]
    apply run_selectiveEmitFinish
      remaining next selectedCode nodeCode
    · rfl
    · simp [NPOracleState.write,
        NPOracleState.jump]
    · simp [NPOracleState.write,
        NPOracleState.jump]
    · simp [NPOracleState.write,
        NPOracleState.jump, hnewSelectedEq, newSelected]
    · simp [NPOracleState.write,
        NPOracleState.jump]
    · exact hbitsOf hnextInc
    · exact hbitsOf hnextIncAndSelected
    · exact hbitsOf hnewState
    · exact hbitsOf houtput

def selectiveSelectedCode {n : ℕ} :
    Option (BooleanNode n) → ℕ
  | none => 0
  | some node => Nat.pair 1 (rawCircuitNodeCode node)

def selectiveStateCode {n : ℕ}
    (state : SelectiveState n) : ℕ :=
  selectiveEmitStateCode
    (state.target - state.next)
    state.next
    (selectiveSelectedCode state.selected)

/-- Encoded compiler wire: the encoded selective state beside the emitted
output register.  Public because it is the exact right-hand side of the
compiler-execution premise of `run_structuralFormulaProgram_of_compiler_run`. -/
def selectiveWireCode {n : ℕ}
    (wire : SelectiveWire n) : ℕ :=
  Nat.pair (selectiveStateCode wire.state) wire.output

/-- Reachable selective states have exactly one of two shapes: the target is
still ahead with no selection, or it has already been crossed and retained. -/
def selectiveStateOrdered {n : ℕ}
    (state : SelectiveState n) : Prop :=
  match state.selected with
  | none => state.next ≤ state.target
  | some _ => state.target < state.next

@[simp] theorem selectiveState_empty_ordered
    (n target : ℕ) :
    selectiveStateOrdered (SelectiveState.empty n target) := by
  simp [selectiveStateOrdered, SelectiveState.empty]

theorem selectiveState_emit_ordered {n : ℕ}
    (state : SelectiveState n) (node : BooleanNode n)
    (hordered : selectiveStateOrdered state) :
    selectiveStateOrdered (state.emit node).state := by
  by_cases htarget : state.target = state.next
  · simp [selectiveStateOrdered, SelectiveState.emit, htarget]
  · cases hselected : state.selected with
    | none =>
        rw [selectiveStateOrdered, hselected] at hordered
        simp only at hordered
        simp [selectiveStateOrdered, SelectiveState.emit,
          htarget, hselected]
        omega
    | some selected =>
        rw [selectiveStateOrdered, hselected] at hordered
        simp only at hordered
        simp [selectiveStateOrdered, SelectiveState.emit,
          htarget, hselected]
        omega

set_option maxHeartbeats 600000 in
-- Unfolding the typed node option through both encoded state records is costly.
theorem selectiveEmitOutput_eq_wireCode {n : ℕ}
    (state : SelectiveState n) (node : BooleanNode n)
    (hordered : selectiveStateOrdered state) :
    selectiveEmitOutput
        (state.target - state.next)
        state.next
        (selectiveSelectedCode state.selected)
        (rawCircuitNodeCode node) =
      selectiveWireCode (state.emit node) := by
  unfold selectiveStateOrdered at hordered
  have hselection :
      selectiveEmitSelectedCode
          (state.target - state.next)
          (selectiveSelectedCode state.selected)
          (rawCircuitNodeCode node) =
        selectiveSelectedCode
          (if state.target = state.next then
            some node
          else
            state.selected) := by
    cases hselected : state.selected with
    | none =>
        rw [hselected] at hordered
        simp only at hordered
        by_cases htarget : state.target = state.next
        · simp [selectiveEmitSelectedCode,
            selectiveSelectedCode, htarget]
        · have hremaining :
              state.target - state.next ≠ 0 := by omega
          simp [selectiveEmitSelectedCode,
            selectiveSelectedCode, htarget,
            hremaining]
    | some selected =>
        rw [hselected] at hordered
        simp only at hordered
        have htarget : state.target ≠ state.next := by omega
        have hselectedCode :
            Nat.pair 1 (rawCircuitNodeCode selected) ≠ 0 := by
          have hleft :=
            Nat.left_le_pair 1 (rawCircuitNodeCode selected)
          omega
        simp [selectiveEmitSelectedCode,
          selectiveSelectedCode, htarget,
          hselectedCode]
  unfold selectiveEmitOutput selectiveWireCode selectiveStateCode
  simp only [SelectiveState.emit]
  rw [Nat.sub_succ, hselection]

/-- Machine refinement of the compiler's sole append operation.  This theorem
is the loop invariant consumed by every later expression and clause scheduler. -/
theorem run_selectiveEmitProgram_eq_emit {n : ℕ}
    (state : SelectiveState n) (node : BooleanNode n)
    (hordered : selectiveStateOrdered state)
    (entry : NPOracleState) (hentryPc : entry.pc = 0)
    (hentryInput :
      entry.registers 0 =
        selectiveEmitInput
          (state.target - state.next)
          state.next
          (selectiveSelectedCode state.selected)
          (rawCircuitNodeCode node)) :
    runNPOracleProgram selectiveEmitProgram
        (selectiveEmitBits
          (state.target - state.next)
          state.next
          (selectiveSelectedCode state.selected)
          (rawCircuitNodeCode node))
        (selectiveEmitFuel
          (state.target - state.next)
          (selectiveSelectedCode state.selected))
        entry =
      some (selectiveWireCode (state.emit node)) := by
  rw [run_selectiveEmitProgram _ _ _ _ entry hentryPc hentryInput]
  exact congrArg some <|
    selectiveEmitOutput_eq_wireCode state node hordered

/-! The nested structural compiler has data-dependent loop clocks.  Its
internal runner lemmas therefore carry the concrete interpreter resources they
construct instead of asking callers to predict a separate clock. -/

structure SelectiveRunWitness
    (program : NPOracleProgram) (state : NPOracleState) (output : ℕ) where
  maximumBits : ℕ
  fuel : ℕ
  executes :
    runNPOracleProgram program maximumBits fuel state = some output

def SelectiveRunWitness.widen
    {program : NPOracleProgram} {state : NPOracleState} {output : ℕ}
    (witness : SelectiveRunWitness program state output)
    (minimumBits : ℕ) :
    SelectiveRunWitness program state output where
  maximumBits := max witness.maximumBits minimumBits
  fuel := witness.fuel
  executes :=
    run_bits_mono witness.executes (Nat.le_max_left _ _)

def selectiveEmitRunWitness {n : ℕ}
    (state : SelectiveState n) (node : BooleanNode n)
    (hordered : selectiveStateOrdered state)
    (entry : NPOracleState) (hentryPc : entry.pc = 0)
    (hentryInput :
      entry.registers 0 =
        selectiveEmitInput
          (state.target - state.next)
          state.next
          (selectiveSelectedCode state.selected)
          (rawCircuitNodeCode node)) :
    SelectiveRunWitness selectiveEmitProgram entry
      (selectiveWireCode (state.emit node)) where
  maximumBits :=
    selectiveEmitBits
      (state.target - state.next)
      state.next
      (selectiveSelectedCode state.selected)
      (rawCircuitNodeCode node)
  fuel :=
    selectiveEmitFuel
      (state.target - state.next)
      (selectiveSelectedCode state.selected)
  executes :=
    run_selectiveEmitProgram_eq_emit state node hordered entry hentryPc
      hentryInput

